@* Blogzine footer: about + newsletter, widget columns, hot topics and copyright bar.
   Presentational only (ts-ui-001). *@

<footer class="bg-dark pt-5">
    <div class="container">
        <!-- About and Newsletter START -->
        <div class="row pt-3 pb-4">
            <div class="col-md-3">
                <BrandComponent Variant="BrandVariant.Banner" BannerHeightPx="72" />
            </div>
            <div class="col-md-5">
                <p class="text-body-secondary">
                    Glory 2 Him is a place to read, reflect, and be encouraged in the good news of
                    Jesus Christ — sharing stories that point all glory back to Him.
                </p>
            </div>
            <div class="col-md-4">
                <!-- Form -->
                <form class="row row-cols-lg-auto g-2 align-items-center justify-content-end">
                    <div class="col-12">
                        <input type="email" class="form-control" placeholder="Enter your email address" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary m-0">Subscribe</button>
                    </div>
                    <div class="form-text mt-2">
                        By subscribing you agree to our
                        <a href="#" class="text-decoration-underline text-reset">Privacy Policy</a>
                    </div>
                </form>
            </div>
        </div>
        <!-- About and Newsletter END -->

        <!-- Divider -->
        <hr />

        <!-- Widgets START -->
        <div class="row pt-5">
            <!-- Footer Widget -->
            <div class="col-md-6 col-lg-3 mb-4">
                <h5 class="mb-4 text-white">Explore</h5>
                <ul class="nav flex-column text-primary-hover">
                    <li class="nav-item"><a class="nav-link pt-0" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="About-Us">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="Categories">Journal</a></li>
                    <li class="nav-item"><a class="nav-link" href="Author">Authors</a></li>
                    <li class="nav-item"><a class="nav-link" href="Contact-Us">Contact us</a></li>
                </ul>
            </div>

            <!-- Footer Widget -->
            <div class="col-md-6 col-lg-3 mb-4">
                <h5 class="mb-4 text-white">Account</h5>
                <ul class="nav flex-column text-primary-hover">
                    <li class="nav-item"><a class="nav-link pt-0" href="Account/Login">Sign in</a></li>
                    <li class="nav-item"><a class="nav-link" href="Account/Register">Sign up</a></li>
                    <li class="nav-item"><a class="nav-link" href="Account/Manage">My account</a></li>
                </ul>
            </div>

            <!-- Footer Widget -->
            <div class="col-sm-6 col-lg-3 mb-4">
                <h5 class="mb-4 text-white">Get Regular Updates</h5>
                <ul class="nav flex-column text-primary-hover">
                    <li class="nav-item"><a class="nav-link pt-0" href="#"><i class="fab fa-whatsapp fa-fw me-2"></i>WhatsApp</a></li>
                    <li class="nav-item"><a class="nav-link" href="#"><i class="fab fa-youtube fa-fw me-2"></i>YouTube</a></li>
                    <li class="nav-item"><a class="nav-link" href="#"><i class="far fa-bell fa-fw me-2"></i>Notifications</a></li>
                    <li class="nav-item"><a class="nav-link" href="#"><i class="far fa-envelope fa-fw me-2"></i>Newsletters</a></li>
                </ul>
            </div>

            <!-- Footer Widget -->
            <div class="col-sm-6 col-lg-3 mb-4">
                <h5 class="mb-4 text-white">A word of hope</h5>
                <p class="text-body-secondary">
                    "Jesus answered, 'I am the way and the truth and the life. No one comes to the
                    Father except through me.'" — John 14:6
                </p>
            </div>
        </div>
        <!-- Widgets END -->

        <!-- Hot topics START -->
        <div class="row">
            <h5 class="mb-2 text-white">Hot topics</h5>
            <ul class="list-inline text-primary-hover lh-lg">
                <li class="list-inline-item"><a href="Categories">Faith</a></li>
                <li class="list-inline-item"><a href="Categories">Hope</a></li>
                <li class="list-inline-item"><a href="Categories">Prayer</a></li>
                <li class="list-inline-item"><a href="Categories">Scripture</a></li>
                <li class="list-inline-item"><a href="Categories">Testimony</a></li>
                <li class="list-inline-item"><a href="Categories">Worship</a></li>
                <li class="list-inline-item"><a href="Categories">Community</a></li>
                <li class="list-inline-item"><a href="Categories">Missions</a></li>
            </ul>
        </div>
        <!-- Hot topics END -->
    </div>

    <!-- Footer copyright START -->
    <div class="bg-dark-overlay-3 mt-5">
        <div class="container">
            <div class="row align-items-center justify-content-md-between py-4">
                <div class="col-md-6">
                    <div class="text-center text-md-start text-primary-hover text-body-secondary">
                        ©@CurrentYear Glory 2 Him. Free to use to help share the Gospel.
                    </div>
                </div>
                <div class="col-md-6 d-sm-flex align-items-center justify-content-center justify-content-md-end">
                    <ul class="nav text-primary-hover text-center text-sm-end justify-content-center mt-3 mt-md-0">
                        <li class="nav-item"><a class="nav-link" href="#">Terms</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Privacy</a></li>
                        <li class="nav-item"><a class="nav-link pe-0" href="#">Cookies</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer copyright END -->
</footer>

@code {
    private static int CurrentYear => DateTime.UtcNow.Year;
}
