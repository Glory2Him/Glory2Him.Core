@* ---
   Blogzine header chrome: top bar (accessibility + dark-mode + social), logo navbar with
   dropdown menus, and the right-hand search / subscribe / offcanvas controls.
   The textless Glory2Him sunset-over-mountains photo sits behind the whole header as a single
   full-bleed background (see HeaderComponent.razor.css); navbar-dark switches every nav-link,
   icon and the wordmark to white so they stay readable over it, and the accessibility buttons ride
   a light pill for the same reason. Presentational only — no data access (ts-ui-001). --- *@

<header class="navbar-dark navbar-sticky header-static g2h-header-photo">
    <div class="navbar-top d-none d-lg-block small">
        <div class="container">
            <div class="d-md-flex justify-content-between align-items-center my-2">
                <!-- Top bar left -->
                <ul class="nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link ps-0" href="About-Us">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="Contact-Us">Contact</a>
                    </li>
                    <AuthorizeView>
                        <Authorized>
                            @if (context.User.IsInRole("Administrators"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="Admin/Users">Admin</a>
                                </li>
                            }
                            @* Always shown (not just for administrators): it separates
                               About/Contact from the signed-in user's own links, whether that's
                               just the profile + logout, or the admin link too. *@
                            <li class="nav-item d-flex align-items-center">
                                <span class="text-white-50" aria-hidden="true">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link d-flex align-items-center" href="Account/Manage">
                                    <i class="bi bi-person me-1"></i>
                                    @ToDisplayName(context.User.Identity?.Name)
                                </a>
                            </li>
                            <li class="nav-item">
                                @* The button itself is a fully reset, invisible click target
                                   (no border/background/padding of its own — .btn's padding and
                                   line-height fought with .nav-link's, leaving the text baseline
                                   slightly higher than the sibling <a> links). The actual nav-link
                                   styling lives on the inner span instead, which renders with the
                                   exact same box as "About"/"Contact"/"Admin". *@
                                <form action="Account/Logout" method="post" class="d-inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="" />
                                    <button type="submit" class="p-0 border-0 bg-transparent">
                                        <span class="nav-link d-flex align-items-center">
                                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                                        </span>
                                    </button>
                                </form>
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="nav-item d-flex align-items-center">
                                <span class="text-white-50" aria-hidden="true">|</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="Account/Login">Login / Join</a>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>
                </ul>
                <!-- Top bar right -->
                <div class="d-flex align-items-center">
                    <!-- Font size accessibility START -->
                    <div class="btn-group me-3 g2h-header-pill" role="group" aria-label="font size changer">
                        <input type="radio" class="btn-check" name="fntradio" id="font-sm" />
                        <label class="btn btn-xs btn-outline-primary mb-0" for="font-sm">A-</label>

                        <input type="radio" class="btn-check" name="fntradio" id="font-default" checked />
                        <label class="btn btn-xs btn-outline-primary mb-0" for="font-default">A</label>

                        <input type="radio" class="btn-check" name="fntradio" id="font-lg" />
                        <label class="btn btn-xs btn-outline-primary mb-0" for="font-lg">A+</label>
                    </div>

                    <!-- Dark mode options START -->
                    <div class="nav-item dropdown mx-2">
                        <button class="modeswitch" id="bd-theme" type="button" aria-expanded="false" data-bs-toggle="dropdown" data-bs-display="static">
                            <svg class="theme-icon-active"><use href="#"></use></svg>
                        </button>
                        <ul class="dropdown-menu min-w-auto dropdown-menu-end" aria-labelledby="bd-theme">
                            <li class="mb-1">
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="light">
                                    <svg width="16" height="16" fill="currentColor" class="bi bi-brightness-high-fill fa-fw mode-switch me-1" viewBox="0 0 16 16">
                                        <path d="M12 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0zM8 0a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 0zm0 13a.5.5 0 0 1 .5.5v2a.5.5 0 0 1-1 0v-2A.5.5 0 0 1 8 13zm8-5a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2a.5.5 0 0 1 .5.5zM3 8a.5.5 0 0 1-.5.5h-2a.5.5 0 0 1 0-1h2A.5.5 0 0 1 3 8zm10.657-5.657a.5.5 0 0 1 0 .707l-1.414 1.415a.5.5 0 1 1-.707-.708l1.414-1.414a.5.5 0 0 1 .707 0zm-9.193 9.193a.5.5 0 0 1 0 .707L3.05 13.657a.5.5 0 0 1-.707-.707l1.414-1.414a.5.5 0 0 1 .707 0zm9.193 2.121a.5.5 0 0 1-.707 0l-1.414-1.414a.5.5 0 0 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .707zM4.464 4.465a.5.5 0 0 1-.707 0L2.343 3.05a.5.5 0 1 1 .707-.707l1.414 1.414a.5.5 0 0 1 0 .708z" />
                                        <use href="#"></use>
                                    </svg>Light
                                </button>
                            </li>
                            <li class="mb-1">
                                <button type="button" class="dropdown-item d-flex align-items-center" data-bs-theme-value="dark">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-moon-stars-fill fa-fw mode-switch me-1" viewBox="0 0 16 16">
                                        <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C3.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278z" />
                                        <path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.518.579.924 1.097 1.097l1.162.387a.217.217 0 0 1 0 .412l-1.162.387a1.734 1.734 0 0 0-1.097 1.097l-.387 1.162a.217.217 0 0 1-.412 0l-.387-1.162A1.734 1.734 0 0 0 9.31 6.593l-1.162-.387a.217.217 0 0 1 0-.412l1.162-.387a1.734 1.734 0 0 0 1.097-1.097l.387-1.162zM13.863.099a.145.145 0 0 1 .274 0l.258.774c.115.346.386.617.732.732l.774.258a.145.145 0 0 1 0 .274l-.774.258a1.156 1.156 0 0 0-.732.732l-.258.774a.145.145 0 0 1-.274 0l-.258-.774a1.156 1.156 0 0 0-.732-.732l-.774-.258a.145.145 0 0 1 0-.274l.774-.258c.346-.115.617-.386.732-.732L13.863.1z" />
                                        <use href="#"></use>
                                    </svg>Dark
                                </button>
                            </li>
                            <li>
                                <button type="button" class="dropdown-item d-flex align-items-center active" data-bs-theme-value="auto">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-circle-half fa-fw mode-switch me-1" viewBox="0 0 16 16">
                                        <path d="M8 15A7 7 0 1 0 8 1v14zm0 1A8 8 0 1 1 8 0a8 8 0 0 1 0 16z" />
                                        <use href="#"></use>
                                    </svg>Auto
                                </button>
                            </li>
                        </ul>
                    </div>
                    <!-- Dark mode options END -->

                    <ul class="nav">
                        <li class="nav-item">
                            <a class="nav-link px-2 fs-5" href="#"><i class="fab fa-facebook-square"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 fs-5" href="#"><i class="fab fa-twitter-square"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 fs-5" href="#"><i class="fab fa-linkedin"></i></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-2 fs-5" href="#"><i class="fab fa-youtube-square"></i></a>
                        </li>
                    </ul>
                </div>
            </div>
            <!-- Divider -->
            <div class="border-bottom border-2 border-primary opacity-1"></div>
        </div>
    </div>

    <!-- Logo Nav START -->
    @* navbar-dark repeats here (in addition to <header>): Bootstrap's .navbar rule resets the
       brand/link color custom properties for its own subtree, so the header's navbar-dark alone
       doesn't reach the brand text or the nav links nested inside .navbar. *@
    <nav class="navbar navbar-dark navbar-expand-lg">
        <div class="container">
            <!-- Logo START -->
            <a class="navbar-brand" href="/">
                <BrandComponent Variant="BrandVariant.Text" AccentTwo="false" />
            </a>
            <!-- Logo END -->

            <!-- Section nav START -->
            @* The three sections of the site, centred between the wordmark and the search button.
               mx-auto is what centres them: it takes the space either side, so the group sits in
               the middle of what is left rather than butting up against the brand.
               Hidden below lg — the wordmark, the Search button and the icons already fill a phone
               width, and the offcanvas menu covers navigation there. *@
            <ul class="navbar-nav flex-row flex-nowrap align-items-center mx-auto d-none d-lg-flex g2h-section-nav">
                <li class="nav-item">
                    <a class="nav-link" href="/">Posts</a>
                </li>

                <li class="nav-item" aria-hidden="true">
                    <span class="nav-link px-2 opacity-50">|</span>
                </li>

                @* Spans, not links: these two sections have no route yet, and an anchor that goes
                   nowhere is worse than plain text. Swap each for an <a href> when they do. *@
                <li class="nav-item">
                    <span class="nav-link g2h-section-pending" title="Coming soon">Series</span>
                </li>

                <li class="nav-item" aria-hidden="true">
                    <span class="nav-link px-2 opacity-50">|</span>
                </li>

                <li class="nav-item">
                    <span class="nav-link g2h-section-pending" title="Coming soon">The Gospel</span>
                </li>
            </ul>
            <!-- Section nav END -->

            <!-- Nav right START -->
            @* The dropdowns and the Subscribe button that used to fill this bar are gone — search
               is the way into the site now. The responsive toggler went with them: it existed only
               to open #navbarCollapse, which no longer exists. *@
            <div class="nav flex-nowrap align-items-center">
                <!-- Search -->
                @* Replaces the magnifier that used to drop a small search form down here: that
                   posted to Search-Result, and having two search entry points in one header meant
                   two different result pages. This one just goes to /Search. *@
                <div class="nav-item me-2">
                    <a href="/Search" class="btn btn-success mb-0 d-flex align-items-center">
                        <i class="bi bi-search me-2"></i>Search
                    </a>
                </div>
                <!-- Notifications + profile menu (CoreUI-style) -->
                <UserMenuComponent />
                <!-- Offcanvas menu toggler -->
                <div class="nav-item">
                    <a class="nav-link p-0" data-bs-toggle="offcanvas" href="#offcanvasMenu" role="button" aria-controls="offcanvasMenu">
                        <i class="bi bi-text-right rtl-flip fs-2" data-bs-target="#offcanvasMenu"> </i>
                    </a>
                </div>
            </div>
            <!-- Nav right END -->
        </div>
    </nav>
    <!-- Logo Nav END -->
</header>

@code {
    // The identity name is the raw username ("admin"), which reads as a typo next to the other
    // top-bar links — capitalize it for display only.
    private static string ToDisplayName(string? userName) =>
        string.IsNullOrWhiteSpace(userName)
            ? string.Empty
            : char.ToUpperInvariant(userName[0]) + userName[1..];
}
