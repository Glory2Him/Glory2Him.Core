@namespace Glory2Him.WebApp.Components.Navigation
@using Glory2Him.WebApp.Models.Views.Navigations
@using Microsoft.AspNetCore.Components.Authorization

@* CoreUI-style left sidebar menu, restyled with Blogzine/Bootstrap classes and Bootstrap Icons.
   Menu tree comes from NavMenuProvider, narrowed to the area being viewed; role/auth gating via
   AuthorizeView (ts-ui-001).

   Top-level items render as a section heading; deeper items that still have children render as a
   collapsible nav-group. Collapsing uses Bootstrap's own data-bs-toggle rather than an @@onclick
   handler, because this menu also renders on the statically rendered Account pages where there is
   no circuit to handle events. *@

<nav class="sidebar-nav">
    <ul class="nav flex-column">
        @foreach (NavItem item in VisibleItems)
        {
            @if (item.Roles is { Length: > 0 })
            {
                <AuthorizeView Roles="@string.Join(",", item.Roles)" Context="roleState">
                    @RenderSection(item)
                </AuthorizeView>
            }
            else if (item.RequiresAuth)
            {
                <AuthorizeView Context="authState">
                    @RenderSection(item)
                </AuthorizeView>
            }
            else
            {
                @RenderSection(item)
            }
        }
    </ul>
</nav>

@code {
    private RenderFragment RenderSection(NavItem item) => __builder =>
    {
        @if (item.HasChildren)
        {
            <li class="nav-item mt-3">
                <span class="nav-title text-uppercase small fw-bold text-body-secondary px-3">
                    <i class="bi @item.Icon me-1"></i>@item.Title
                </span>
            </li>

            @foreach (NavItem child in item.Children!)
            {
                @RenderNode(child)
            }
        }
        else
        {
            @RenderNode(item)
        }
    };

    private RenderFragment RenderNode(NavItem item) => __builder =>
    {
        @if (item.HasChildren)
        {
            string groupId = GetGroupId(item);
            bool isOpen = IsBranchActive(item);

            <li class="nav-item nav-group">
                <a class="nav-link nav-group-toggle d-flex align-items-center @(isOpen ? string.Empty : "collapsed")"
                   data-bs-toggle="collapse"
                   href="#@groupId"
                   role="button"
                   aria-controls="@groupId"
                   aria-expanded="@(isOpen ? "true" : "false")">
                    <i class="bi @item.Icon me-2"></i>@item.Title
                    <i class="bi bi-chevron-down ms-auto g2h-nav-chevron"></i>
                </a>

                <ul class="nav flex-column nav-group-items collapse @(isOpen ? "show" : string.Empty)"
                    id="@groupId">
                    @foreach (NavItem child in item.Children!)
                    {
                        @RenderNode(child)
                    }
                </ul>
            </li>
        }
        else
        {
            <li class="nav-item">
                <NavLink class="nav-link d-flex align-items-center"
                         href="@item.Href"
                         Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                    <i class="bi @item.Icon me-2"></i>@item.Title
                </NavLink>
            </li>
        }
    };
}
