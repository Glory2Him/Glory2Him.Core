@namespace Glory2Him.WebApp.Components.CoreUI

@* Divider-separated byline: avatar, author, date and whichever engagement counts are supplied.
   A count of null is left out entirely rather than shown as a zero, so a card only ever claims
   numbers it actually has. Presentational only (ts-ui-001). *@

<ul class="nav nav-divider align-items-center small @CssClass">
    @if (ShowAuthor)
    {
        <li class="nav-item">
            <div class="nav-link ps-0">
                <div class="d-flex align-items-center position-relative">
                    <AvatarComponent Name="@AuthorName" ImageUrl="@AuthorImageUrl" SizePx="24" />
                    <span class="ms-2">by @AuthorName</span>
                </div>
            </div>
        </li>
    }

    @if (PublishedDate is not null)
    {
        <li class="nav-item">@PublishedDate.Value.ToString("MMM dd, yyyy")</li>
    }

    @if (ReadMinutes is not null)
    {
        <li class="nav-item">@ReadMinutes min read</li>
    }

    @if (Reactions is not null)
    {
        <li class="nav-item"><i class="far fa-heart me-1"></i>@Reactions</li>
    }

    @if (Comments is not null)
    {
        <li class="nav-item"><i class="far fa-comment me-1"></i>@Comments</li>
    }

    @if (TagCount is not null)
    {
        <li class="nav-item"><i class="fas fa-tag me-1"></i>@TagCount</li>
    }

    @if (ReferenceCount is not null)
    {
        <li class="nav-item"><i class="bi bi-book me-1"></i>@ReferenceCount</li>
    }

    @if (Views is not null)
    {
        <li class="nav-item"><i class="far fa-eye me-1"></i>@Views Views</li>
    }
</ul>
