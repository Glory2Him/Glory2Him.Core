@namespace Glory2Him.WebApp.Components.CoreUI

@* Tinted strip carrying the day's verse, sitting directly under the header.
   Presentational only (ts-ui-001). *@

<section class="py-2">
    <div class="container">
        <div class="row g-0">
            <div class="col-12 bg-primary bg-opacity-10 p-2 rounded">
                <div class="d-sm-flex align-items-center text-center text-sm-start">
                    <div class="me-3">
                        <span class="badge bg-primary p-2 px-3">@Label</span>
                    </div>
                    <div>
                        <a href="@Href" class="text-reset btn-link">@Verse</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
