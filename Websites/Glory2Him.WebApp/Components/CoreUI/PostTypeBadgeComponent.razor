@namespace Glory2Him.WebApp.Components.CoreUI

@* Small round icon marking what kind of post this is — video, audio, gallery or quote — as used
   on the Blogzine post-types layout. Presentational only (ts-ui-001). *@

<span class="badge rounded-circle @BackgroundCssClass d-inline-flex align-items-center justify-content-center"
      style="width:@(SizePx)px;height:@(SizePx)px;"
      role="img"
      aria-label="@Label"
      title="@Label">
    <i class="bi @IconCssClass"></i>
</span>
