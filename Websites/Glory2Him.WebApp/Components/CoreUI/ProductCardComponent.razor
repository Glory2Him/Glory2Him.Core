@namespace Glory2Him.WebApp.Components.CoreUI

@* Reusable shop product card (Blogzine "shop-grid" item). Renders a single ProductView and
   raises OnAddToCart — no service access here (ts-ui-001). *@

<div class="card border p-3 h-100">
    <div class="position-relative">
        <a href="@ProductHref" class="position-relative z-index-9">
            <img class="card-img" src="@Product.ImageUrl" alt="@Product.Name" />
        </a>
        @if (!string.IsNullOrWhiteSpace(Product.Badge))
        {
            <div class="card-img-overlay p-0">
                <div><span class="badge @Product.BadgeCss">@Product.Badge</span></div>
            </div>
        }
    </div>

    <div class="card-body text-center p-3 px-0">
        <div class="d-flex justify-content-center mb-2">
            <ul class="list-inline mb-0">
                @for (int star = 1; star <= 5; star++)
                {
                    <li class="list-inline-item me-0 small">
                        <i class="fas @StarIcon(star) text-warning"></i>
                    </li>
                }
            </ul>
        </div>
        <h5 class="card-title"><a href="@ProductHref">@Product.Name</a></h5>
        <h6 class="mb-0 text-success">@Product.Price.ToString("C")</h6>
    </div>

    <div class="card-footer text-center p-0">
        <button type="button" class="btn btn-sm btn-primary-soft mb-0" @onclick="AddToCartAsync">
            <i class="bi bi-cart me-2"></i>Add to cart
        </button>
    </div>
</div>
