@namespace Glory2Him.WebApp.Components.CoreUI

@* Post card whose title and byline sit over the image behind a bottom gradient (Blogzine
   "card-overlay-bottom card-img-scale"). Renders a single PostView; data comes from the parent
   via [Parameter] — no service access here (ts-ui-001). *@

<div class="card card-overlay-bottom card-img-scale h-100">
    <img class="card-img" src="@Post.ImageUrl" alt="@Post.Title" />

    <div class="card-img-overlay d-flex align-items-center p-3 p-sm-4">
        <div class="w-100 mt-auto">
            <a href="Categories" class="badge @Post.CategoryBadgeCss mb-2">@Post.Category</a>

            @* Sizing rides on a Bootstrap heading utility class rather than swapping the tag, so
               the heading level stays consistent wherever the card is reused. *@
            <h3 class="text-white @TitleCssClass">
                <a href="Post-Single/@Post.Slug" class="btn-link stretched-link text-reset fw-bold">
                    @Post.Title
                </a>
            </h3>

            <ul class="nav nav-divider text-white-force align-items-center small mb-0">
                <li class="nav-item">by @Post.AuthorName</li>
                <li class="nav-item">@Post.PublishedDate.ToString("MMM dd, yyyy")</li>
            </ul>
        </div>
    </div>
</div>
