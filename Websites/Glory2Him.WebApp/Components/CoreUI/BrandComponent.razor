@namespace Glory2Him.WebApp.Components.CoreUI

@* The Glory 2 Him site brand. The banner artwork carries the wordmark on its own, so the compact
   icon + text lockup is what renders wherever the banner will not fit (narrow screens, the sticky
   navbar). Sizes come from BrandComponent.razor.css unless a caller overrides them.
   Presentational only (ts-ui-001). *@

@if (Variant is BrandVariant.Banner or BrandVariant.Responsive)
{
    <img class="g2h-brand-banner @(Variant is BrandVariant.Responsive ? "d-none d-lg-block" : string.Empty)"
         style="@BannerStyle"
         src="assets/images/glory2him-banner.png"
         alt="Glory 2 Him" />
}

@if (Variant is BrandVariant.Compact or BrandVariant.Responsive)
{
    <span class="g2h-brand-compact d-inline-flex align-items-center @(Variant is BrandVariant.Responsive ? "d-lg-none" : string.Empty)">
        <img class="g2h-brand-icon rounded" style="@IconStyle"
             src="assets/images/glory2him-icon.png" alt="" />

        <span class="g2h-brand-name ms-2 fw-bold lh-1" style="@NameStyle">
            Glory <span class="@TwoSpanClass">2</span> Him
        </span>
    </span>
}

@if (Variant is BrandVariant.Text)
{
    <span class="g2h-brand-name fw-bold lh-1" style="@NameStyle">
        Glory <span class="@TwoSpanClass">2</span> Him
    </span>
}
