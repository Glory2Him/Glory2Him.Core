@namespace Glory2Him.WebApp.Components.CoreUI

@* "How did this post speak to you?" — a row of reaction buttons under an article.
   Presentational only; the parent decides what a reaction means (ts-ui-001). *@

<div class="bg-light rounded p-4 mt-5 text-center">
    <h5 class="mb-3">@Prompt</h5>

    <div class="d-flex justify-content-center flex-wrap" style="gap: 10px;">
        @foreach (ReactionOption reaction in Reactions)
        {
            <button type="button" class="reaction-btn" @onclick="() => OnReact.InvokeAsync(reaction)">
                <i class="@reaction.IconCssClass" style="color: @reaction.Color;"></i>
                <span>@reaction.Label</span>
                <span class="fw-bold">@reaction.Count</span>
            </button>
        }
    </div>
</div>
