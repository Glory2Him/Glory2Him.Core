@namespace Glory2Him.WebApp.Components.CoreUI

@* Reusable horizontal post row (Blogzine "post-list" item). Renders a single PostView.
   Data supplied by the parent via [Parameter] — no service access here (ts-ui-001). *@

<div class="card mb-4">
    <div class="row g-0">
        <div class="col-md-4">
            <img class="rounded-3 h-100 object-fit-cover" src="@Post.ImageUrl" alt="@Post.Title" />
        </div>
        <div class="col-md-8">
            <div class="card-body h-100 d-flex flex-column">
                <a href="categories" class="badge @Post.CategoryBadgeCss mb-2 align-self-start">@Post.Category</a>
                <h3 class="card-title">
                    <a href="@PostHref" class="btn-link text-reset stretched-link fw-bold">@Post.Title</a>
                </h3>
                <p class="card-text">@Post.Excerpt</p>
                <ul class="nav nav-divider align-items-center mt-auto">
                    <li class="nav-item">
                        <div class="nav-link">
                            <div class="avatar avatar-xs">
                                <img class="avatar-img rounded-circle" src="@Post.AuthorImageUrl" alt="@Post.AuthorName" />
                            </div>
                        </div>
                    </li>
                    <li class="nav-item">by <span class="text-reset btn-link">@Post.AuthorName</span></li>
                    <li class="nav-item">@PublishedDateText</li>
                    <li class="nav-item">@Post.ReadMinutes min read</li>
                </ul>
            </div>
        </div>
    </div>
</div>
