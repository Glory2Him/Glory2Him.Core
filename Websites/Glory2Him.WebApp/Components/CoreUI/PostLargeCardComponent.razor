@namespace Glory2Him.WebApp.Components.CoreUI

@* Wide lead story: image on one side, headline and excerpt on the other (Blogzine
   post-large-and-grid). Flips to image-on-top on narrow screens. Presentational only
   (ts-ui-001). *@

<div class="card border h-100">
    <div class="row g-0 h-100">
        <div class="@ImageColumnCssClass">
            <img class="w-100 h-100 rounded-start" src="@Post.ImageUrl" alt="@Post.Title"
                 style="object-fit:cover;min-height:220px;" />
        </div>

        <div class="@BodyColumnCssClass">
            <div class="card-body h-100 d-flex flex-column">
                <div>
                    <a href="Categories" class="badge @Post.CategoryBadgeCss mb-2">@Post.Category</a>

                    <h2 class="@TitleCssClass">
                        <a href="Post-Single/@Post.Slug"
                           class="btn-link text-reset stretched-link fw-bold">@Post.Title</a>
                    </h2>

                    <p class="card-text">@Post.Excerpt</p>
                </div>

                <ul class="nav nav-divider align-items-center small mt-auto mb-0">
                    <li class="nav-item">
                        <div class="nav-link ps-0">
                            <AvatarComponent Name="@Post.AuthorName"
                                             ImageUrl="@Post.AuthorImageUrl" SizePx="28" />
                        </div>
                    </li>
                    <li class="nav-item">by @Post.AuthorName</li>
                    <li class="nav-item">@Post.PublishedDate.ToString("MMM dd, yyyy")</li>
                    <li class="nav-item">@Post.ReadMinutes min read</li>
                </ul>
            </div>
        </div>
    </div>
</div>
