@namespace Glory2Him.WebApp.Components.CoreUI

@* Full-width category dropdown (Blogzine's "Lifestyle" mega menu): a row of post thumbnails with
   a topic pill cloud beneath. Bootstrap's own dropdown drives it, so it works under static SSR.
   Presentational only (ts-ui-001). *@

<li class="nav-item dropdown dropdown-fullwidth">
    <a class="nav-link dropdown-toggle" href="#" id="@MenuId"
       data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        @Title
    </a>

    <div class="dropdown-menu p-4" aria-labelledby="@MenuId">
        <div class="row g-4">
            @foreach (PostView post in Posts)
            {
                <div class="col-sm-6 col-lg-3">
                    <div class="card bg-transparent">
                        <img class="card-img rounded" src="@post.ImageUrl" alt="@post.Title" />
                        <div class="card-body px-0 pt-3">
                            <a href="Categories" class="badge @post.CategoryBadgeCss mb-2">
                                @post.Category
                            </a>
                            <h6 class="card-title mb-0">
                                <a href="Post-Single/@post.Slug"
                                   class="btn-link text-reset stretched-link fw-bold">@post.Title</a>
                            </h6>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Topics.Any())
        {
            <hr />
            <h6 class="text-uppercase small text-body-secondary mb-3">Browse topics</h6>
            <ul class="list-inline mb-0">
                @foreach (string topic in Topics)
                {
                    <li class="list-inline-item mb-2">
                        <a href="Tag?name=@Uri.EscapeDataString(topic)"
                           class="btn btn-sm btn-primary-soft">@topic</a>
                    </li>
                }
            </ul>
        }
    </div>
</li>
