@namespace Glory2Him.WebApp.Components.CoreUI

@* Comment list with single-level replies (a reply is simply indented), followed by the reply form.
   Presentational only — the parent owns submission (ts-ui-001). *@

<div>
    <h3 class="mb-4">@Comments.Count comments</h3>

    @foreach (CommentEntry comment in Comments)
    {
        <div class="my-4 d-flex @(comment.IsReply ? "ps-2 ps-md-5" : string.Empty)">
            <div class="flex-shrink-0 me-3">
                <AvatarComponent Name="@comment.AuthorName"
                                 ImageUrl="@comment.AuthorImageUrl" SizePx="48" />
            </div>

            <div>
                <div class="mb-2">
                    <h5 class="m-0">@comment.AuthorName</h5>
                    <span class="me-3 small text-body-secondary">
                        @comment.PostedAt.ToString("MMM dd, yyyy 'at' h:mm tt")
                    </span>
                    <a href="#reply" class="text-body fw-normal small">Reply</a>
                </div>

                <p class="mb-1">@comment.Body</p>

                <button type="button" class="cmt-react"
                        @onclick="() => OnReact.InvokeAsync(comment)">
                    <i class="far fa-heart me-1"></i>@comment.Reactions
                </button>
            </div>
        </div>
    }
</div>

@if (ShowReplyForm)
{
    <div id="reply" class="mt-5">
        <h3 class="mb-4">Leave a reply</h3>

        <div class="row">
            <div class="col-md-6">
                <FormText Label="Name *" Placeholder="Your name" />
            </div>
            <div class="col-md-6">
                <FormText Label="Email *" Placeholder="you@example.com" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Comment *</label>
            <textarea class="form-control" rows="4" placeholder="Share your thoughts…"></textarea>
        </div>

        <Button Color="primary">Post comment</Button>
    </div>
}
