@namespace Glory2Him.WebApp.Components.CoreUI

@* A chapter of scripture: the reference as the heading, share links alongside, then each section
   under its own sub-heading with the verse numbers set small and raised inline against flowing
   text. Presentational only — the caller supplies the text (ts-ui-001). *@

<div class="d-flex justify-content-between align-items-start mb-3">
    <h2 class="mb-0">@Reference</h2>

    @if (ShowShareLinks)
    {
        <ul class="nav text-white-force flex-nowrap">
            <li class="nav-item">
                <a class="nav-link icon-sm rounded-circle me-2 p-0 bg-facebook" href="#"
                   aria-label="Share on Facebook">
                    <i class="fab fa-facebook-square align-middle"></i>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link icon-sm rounded-circle p-0 bg-twitter" href="#"
                   aria-label="Share on Twitter">
                    <i class="fab fa-twitter-square align-middle"></i>
                </a>
            </li>
        </ul>
    }
</div>

@foreach (BibleSection section in Sections)
{
    @if (!string.IsNullOrWhiteSpace(section.Heading))
    {
        <h3 class="h5 mt-4 mb-2">@section.Heading</h3>
    }

    <p class="g2h-chapter-text">
        @foreach (BibleVerse verse in section.Verses)
        {
            <sup class="g2h-verse-number">@verse.Number</sup>

            @* Trailing space keeps verses from running together when they flow as one block. *@
            <span class="g2h-verse">@verse.Text</span>
            <text> </text>
        }
    </p>
}
