@namespace Glory2Him.WebApp.Components.CoreUI

@* Reusable blog post card (Blogzine "card-grid" item). Renders a single PostView.
   Data is supplied by the parent via [Parameter] — no service access here (ts-ui-001). *@

<div class="card h-100">
    <div class="position-relative">
        <img class="card-img" src="@Post.ImageUrl" alt="@Post.Title" />
        <div class="card-img-overlay d-flex align-items-start flex-column p-3">
            <div class="w-100 align-items-center text-start">
                <a href="Categories" class="badge @Post.CategoryBadgeCss">@Post.Category</a>
            </div>
        </div>
    </div>
    <div class="card-body px-3 pt-3">
        <h4 class="card-title">
            <a href="@PostHref" class="btn-link text-reset stretched-link fw-bold">@Post.Title</a>
        </h4>
        @if (ShowExcerpt)
        {
            <p class="card-text">@Post.Excerpt</p>
        }
        <ul class="nav nav-divider align-items-center">
            <li class="nav-item">
                <div class="nav-link">
                    <div class="avatar avatar-xs">
                        <img class="avatar-img rounded-circle" src="@Post.AuthorImageUrl" alt="@Post.AuthorName" />
                    </div>
                </div>
            </li>
            <li class="nav-item">
                by <span class="text-reset btn-link">@Post.AuthorName</span>
            </li>
            <li class="nav-item">@PublishedDateText</li>
        </ul>
    </div>
</div>
