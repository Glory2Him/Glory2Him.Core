@namespace Glory2Him.WebApp.Components.CoreUI

@* A box that turns what you type into tags: press Enter and the word joins the list above as a
   pill, each carrying a red cross to take it back off again.
   Presentational only — the parent owns the list and decides what it means (ts-ui-001).

   Note for callers: this must not sit inside a <form> that has a submit button, or the browser
   will submit the form on Enter before the tag is ever added. *@

@if (Tags.Count > 0)
{
    <div class="d-flex flex-wrap gap-2 mb-2">
        @foreach (string tag in Tags)
        {
            <span class="btn @TagCssClass g2h-tag-pill mb-0">
                @tag

                <button type="button" class="g2h-tag-remove ms-1"
                        title="Remove tag"
                        aria-label="Remove @tag"
                        @onclick="@(() => RemoveAsync(tag))">
                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                </button>
            </span>
        }
    </div>
}

<input class="form-control" type="text" placeholder="@Placeholder"
       value="@this.draft"
       @oninput="OnDraftChanged"
       @onkeydown="OnKeyDownAsync"
       aria-label="@AriaLabel" />
