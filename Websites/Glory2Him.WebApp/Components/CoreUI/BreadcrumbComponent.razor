@namespace Glory2Him.WebApp.Components.CoreUI
@using Glory2Him.WebApp.Models.Views.Navigations

@* Reusable breadcrumb trail. Presentational only (ts-ui-001). *@

<nav aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        @foreach (BreadcrumbItem item in Items)
        {
            @if (item.IsActive)
            {
                <li class="breadcrumb-item active" aria-current="page">@item.Title</li>
            }
            else
            {
                <li class="breadcrumb-item"><a href="@item.Href">@item.Title</a></li>
            }
        }
    </ol>
</nav>
