@namespace Glory2Him.WebApp.Components.CoreUI

@* A chapter reader in the manner of bible.com: a bar carrying the chapter and the translation, a
   toggle that splits the page into two translations side by side, and a chevron on each side to
   step to the neighbouring chapter.

   Presentational only — the caller hands over the chapter list, the translations, and a lookup for
   the text of any (chapter, translation) pair (ts-ui-001). *@

<div class="g2h-scripture-bar d-flex flex-wrap align-items-center gap-3 pb-3 mb-4 border-bottom">
    <select class="form-select g2h-scripture-select" value="@Chapter"
            @onchange="OnChapterSelected" aria-label="Chapter">
        @for (int number = 1; number <= ChapterCount; number++)
        {
            <option value="@number">@Book @number</option>
        }
    </select>

    <select class="form-select g2h-scripture-select" value="@this.primaryCode"
            @onchange="OnPrimaryTranslationSelected" aria-label="Translation">
        @foreach (ScriptureTranslation translation in Translations)
        {
            <option value="@translation.Code">@translation.Name</option>
        }
    </select>

    @if (this.isParallel)
    {
        <select class="form-select g2h-scripture-select" value="@this.secondaryCode"
                @onchange="OnSecondaryTranslationSelected" aria-label="Second translation">
            @foreach (ScriptureTranslation translation in Translations)
            {
                <option value="@translation.Code">@translation.Name</option>
            }
        </select>
    }

    <button type="button" class="btn btn-link p-0 mb-0 d-flex align-items-center"
            @onclick="ToggleParallel" aria-pressed="@(this.isParallel ? "true" : "false")">
        <i class="bi bi-layout-split me-2"></i>@(this.isParallel ? "Exit Parallel Mode" : "Parallel")
    </button>
</div>

@* The chevrons sit in the flow either side of the text rather than floating over it — the reading
   column is narrow enough here that an overlaid control would land on the words. *@
<div class="d-flex align-items-center gap-2 gap-lg-3">
    <button type="button" class="btn btn-outline-secondary rounded-circle g2h-scripture-step mb-0"
            @onclick="@(() => GoToChapter(Chapter - 1))"
            disabled="@(Chapter <= 1)"
            title="@PreviousTitle" aria-label="@PreviousTitle">
        <i class="bi bi-chevron-left"></i>
    </button>

    <div class="row g-4 flex-grow-1">
        <div class="@(this.isParallel ? "col-md-6" : "col-12")">
            @RenderChapter(this.primaryCode)
        </div>

        @if (this.isParallel)
        {
            <div class="col-md-6">
                @RenderChapter(this.secondaryCode)
            </div>
        }
    </div>

    <button type="button" class="btn btn-outline-secondary rounded-circle g2h-scripture-step mb-0"
            @onclick="@(() => GoToChapter(Chapter + 1))"
            disabled="@(Chapter >= ChapterCount)"
            title="@NextTitle" aria-label="@NextTitle">
        <i class="bi bi-chevron-right"></i>
    </button>
</div>

@code {
    private RenderFragment RenderChapter(string translationCode) => __builder =>
    {
        IReadOnlyList<BibleSection>? sections = SectionsFor(Chapter, translationCode);

        if (sections is null)
        {
            <h2 class="mb-3">@Book @Chapter</h2>

            <div class="alert alert-info mb-0" role="alert">
                @Book @Chapter is not available in @TranslationName(translationCode) yet.
            </div>
        }
        else
        {
            <BibleChapterComponent Reference="@($"{Book} {Chapter}")"
                                   Sections="sections"
                                   ShowShareLinks="false" />
        }
    };
}
