@namespace Glory2Him.WebApp.Components.CoreUI

@* Horizontal article byline: the author's face and name, then the article's date, reading time and
   engagement counts running along beside them. Wraps onto a second line on narrow screens rather
   than squeezing. Presentational only (ts-ui-001). *@

<div class="d-flex flex-wrap align-items-center gap-3 @CssClass">
    <div class="d-flex align-items-center">
        <AvatarComponent Name="@AuthorName" ImageUrl="@AuthorImageUrl" SizePx="@AvatarSizePx" />

        <span class="ms-2">
            <a href="Author" class="fw-bold text-reset btn-link d-block lh-1">@AuthorName</a>

            @if (!string.IsNullOrWhiteSpace(AuthorRole))
            {
                <span class="small">@AuthorRole</span>
            }
        </span>
    </div>

    <ul class="nav nav-divider align-items-center mb-0">
        @if (PublishedDate is not null)
        {
            <li class="nav-item">@PublishedDate.Value.ToString("MMM dd, yyyy")</li>
        }

        @if (ReadMinutes is not null)
        {
            <li class="nav-item">
                <i class="bi bi-clock-fill me-1"></i>@ReadMinutes min read
            </li>
        }

        @if (Reactions is not null)
        {
            <li class="nav-item"><i class="far fa-heart me-1"></i>@Reactions reactions</li>
        }

        @if (Comments is not null)
        {
            <li class="nav-item"><i class="far fa-comment me-1"></i>@Comments comments</li>
        }

        @if (Views is not null)
        {
            <li class="nav-item"><i class="far fa-eye me-1"></i>@Views Views</li>
        }
    </ul>
</div>
