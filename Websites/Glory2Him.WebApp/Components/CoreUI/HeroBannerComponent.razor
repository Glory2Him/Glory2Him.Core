@namespace Glory2Him.WebApp.Components.CoreUI

@* Full-width photographic page banner with the title and a dotted breadcrumb sitting over a dark
   gradient (Blogzine "card-overlay-bottom h-300"). Presentational only (ts-ui-001). *@

<section class="pt-4">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="card card-overlay-bottom h-300 overflow-hidden text-center"
                     style="background-image:url(@ImageUrl); background-position: center center; background-size: cover;">
                    <div class="card-img-overlay d-flex align-items-center p-3 pb-4 px-sm-5">
                        <div class="col-12 mt-auto d-md-flex justify-content-between align-items-center">
                            <h1 class="text-white display-5 mb-0">@Title</h1>

                            @if (Crumbs.Any())
                            {
                                <nav class="d-flex justify-content-center" aria-label="breadcrumb">
                                    <ol class="breadcrumb breadcrumb-dots mb-0">
                                        <li class="breadcrumb-item">
                                            <a href="/"><i class="bi bi-house me-1"></i>Home</a>
                                        </li>
                                        @foreach (BreadcrumbItem crumb in Crumbs)
                                        {
                                            <li class="breadcrumb-item @(crumb.IsActive ? "active" : string.Empty)">
                                                @if (crumb.IsActive)
                                                {
                                                    @crumb.Title
                                                }
                                                else
                                                {
                                                    <a href="@crumb.Href">@crumb.Title</a>
                                                }
                                            </li>
                                        }
                                    </ol>
                                </nav>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
