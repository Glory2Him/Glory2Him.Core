@page "/Admin/Posts/New"
@page "/Admin/Posts/{PostId}"
@rendermode InteractiveServer
@layout Glory2Him.WebApp.Components.Layout.SidebarLayout
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Models.Views.Navigations
@inherits PostDetailPageBase

@* InteractiveServer: the editor binds field-by-field and saves on a live circuit. *@

<PageTitle>@HeadingText — Glory 2 Him</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@HeadingText</h1>
    <BreadcrumbComponent Items="Crumbs" />
</div>
<hr />

@if (IsLoading)
{
    <div class="text-center py-5">
        <Spinner />
    </div>
}
else if (HasError)
{
    <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    <Button Color="secondary" OnClick="GoBack">Back to Posts</Button>
}
else
{
    <div class="d-flex justify-content-end mb-3">
        <Button Color="secondary" OnClick="GoBack">
            <i class="bi bi-arrow-left me-1"></i>Back to Posts
        </Button>
    </div>

    @if (ActionError is not null)
    {
        <div class="alert alert-danger" role="alert">@ActionError</div>
    }

    <Card CssClass="mb-4">
        <HeaderContent>Post details</HeaderContent>
        <ChildContent>
            <FormText Label="Title" Value="@EditModel.Title"
                      ValueChanged="@(value => EditModel.Title = value ?? string.Empty)" />

            <div class="mb-3">
                <label class="form-label">Excerpt</label>
                <textarea class="form-control" rows="3"
                          value="@EditModel.Excerpt"
                          @oninput="@(args => EditModel.Excerpt = args.Value?.ToString() ?? string.Empty)"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <FormText Label="Category" Value="@EditModel.Category"
                              ValueChanged="@(value => EditModel.Category = value ?? string.Empty)" />
                </div>
                <div class="col-md-6">
                    <FormSelect Label="Badge colour" Value="@EditModel.CategoryBadgeCss"
                                Options="BadgeOptions"
                                ValueChanged="@(value => EditModel.CategoryBadgeCss = value ?? "text-bg-primary")" />
                </div>
            </div>

            <FormText Label="Author" Value="@EditModel.AuthorName"
                      ValueChanged="@(value => EditModel.AuthorName = value ?? string.Empty)" />

            <div class="row">
                <div class="col-md-6">
                    <FormDate Label="Published date" Value="EditModel.PublishedDate"
                              ValueChanged="@(value => EditModel.PublishedDate = value ?? EditModel.PublishedDate)" />
                </div>
                <div class="col-md-6">
                    <FormSwitch Label="Featured" Value="EditModel.IsFeatured"
                                ValueChanged="@(value => EditModel.IsFeatured = value)" />
                </div>
            </div>
        </ChildContent>
        <FooterContent>
            <div class="d-flex flex-wrap justify-content-between gap-2">
                <div class="d-flex gap-2">
                    <Button Color="primary" OnClick="SavePostAsync">Save post</Button>
                    <Button Color="secondary" OnClick="GoBack">Cancel</Button>
                </div>
                @if (IsEditing)
                {
                    <Button Color="outline-danger" OnClick="OpenDeleteDialog">Delete post</Button>
                }
            </div>
        </FooterContent>
    </Card>

    <ConfirmDialog Visible="IsDeleteDialogVisible"
                   Title="Delete post"
                   Message="@DeleteMessage"
                   ConfirmText="Delete"
                   OnConfirm="ConfirmDeleteAsync"
                   OnCancel="CloseDeleteDialog" />
}

@code {
    private BreadcrumbItem[] Crumbs =>
        new[]
        {
            new BreadcrumbItem("Admin"),
            new BreadcrumbItem("Posts", PostsRoute),
            new BreadcrumbItem(IsEditing ? EditModel.Title : "New post", IsActive: true),
        };

    private readonly IReadOnlyList<SelectOption> BadgeOptions =
        new List<SelectOption>
        {
            new SelectOption { Value = "text-bg-primary", Text = "Primary" },
            new SelectOption { Value = "text-bg-success", Text = "Success" },
            new SelectOption { Value = "text-bg-warning", Text = "Warning" },
            new SelectOption { Value = "text-bg-danger", Text = "Danger" },
            new SelectOption { Value = "text-bg-info", Text = "Info" },
        };
}
