@page "/Tag"
@inherits TagBase

@* Tag archive (Blogzine tag.html) — posts filtered by tag/category, with a tag cloud. *@

<PageTitle>Tag: @ActiveTag — Glory 2 Him</PageTitle>

<PageHeaderComponent Title="@($"# {ActiveTag}")" />

<section class="pt-4 pb-5">
    <div class="container">
        <!-- Tag cloud -->
        <ul class="list-inline mb-4">
            <li class="list-inline-item">
                <a href="Tag" class="btn btn-sm @(string.IsNullOrWhiteSpace(TagName) ? "btn-primary" : "btn-primary-soft")">All</a>
            </li>
            @foreach (string tag in Tags)
            {
                <li class="list-inline-item">
                    <a href="Tag?name=@Uri.EscapeDataString(tag)"
                       class="btn btn-sm @(string.Equals(tag, TagName, StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-primary-soft")">
                        @tag
                    </a>
                </li>
            }
        </ul>

        @if (IsLoading)
        {
            <div class="text-center py-5"><Spinner /></div>
        }
        else if (HasError)
        {
            <div class="alert alert-danger" role="alert">@ErrorMessage</div>
        }
        else if (!Posts.Any())
        {
            <div class="alert alert-info" role="alert">No posts tagged <strong>@ActiveTag</strong>.</div>
        }
        else
        {
            <div class="row g-4">
                @foreach (PostView post in Posts)
                {
                    <div class="col-sm-6 col-lg-4">
                        <PostCardComponent Post="post" />
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    // Uri used in markup for tag links.
}
