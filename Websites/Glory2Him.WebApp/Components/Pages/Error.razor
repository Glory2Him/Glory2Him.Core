@page "/Error"
@using System.Diagnostics

<PageTitle>Error — Glory 2 Him</PageTitle>

<section class="position-relative overflow-hidden py-5">
    <div class="container">
        <div class="row justify-content-center text-center py-5">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold text-danger">Something went wrong</h1>
                <p class="mb-4">An unexpected error occurred while processing your request.</p>

                @if (ShowRequestId)
                {
                    <p class="text-muted">
                        <strong>Request ID:</strong> <code>@RequestId</code>
                    </p>
                }

                <a href="/" class="btn btn-primary mb-0">Back to home</a>
            </div>
        </div>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
