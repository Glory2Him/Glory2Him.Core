@page "/Style-Guide"
@rendermode InteractiveServer

@* A single, consolidated component/style guide — the Glory 2 Him equivalent of the Blogzine
   docs pages, showing the reusable components in one place. InteractiveServer so the Modal /
   ConfirmDialog demos are clickable. *@

<PageTitle>Style guide — Glory 2 Him</PageTitle>

<PageHeaderComponent Title="Style guide" />

<section class="pt-4 pb-5">
    <div class="container">

        <h3 class="mb-3">Buttons</h3>
        <div class="d-flex flex-wrap gap-2 mb-5">
            <Button Color="primary">Primary</Button>
            <Button Color="success">Success</Button>
            <Button Color="danger">Danger</Button>
            <Button Color="warning">Warning</Button>
            <Button Color="outline-primary">Outline</Button>
            <Button Color="primary" Disabled="true">Disabled</Button>
        </div>

        <h3 class="mb-3">Stat tiles</h3>
        <div class="row g-4 mb-5">
            <div class="col-sm-6 col-lg-3"><StatTile Variant="StatTileVariant.Green" Icon="bi-check-circle-fill" Value="128" Label="Green" /></div>
            <div class="col-sm-6 col-lg-3"><StatTile Variant="StatTileVariant.Amber" Icon="bi-exclamation-triangle-fill" Value="42" Label="Amber" /></div>
            <div class="col-sm-6 col-lg-3"><StatTile Variant="StatTileVariant.Red" Icon="bi-x-circle-fill" Value="7" Label="Red" /></div>
            <div class="col-sm-6 col-lg-3"><StatTile Variant="StatTileVariant.Na" Icon="bi-info-circle-fill" Value="—" Label="Neutral" /></div>
        </div>

        <h3 class="mb-3">Cards</h3>
        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <Card Title="Card with header">
                    <p class="mb-0">A simple card using the reusable CoreUI Card component.</p>
                </Card>
            </div>
            <div class="col-md-6">
                <Card>
                    <p class="mb-0">A card with no header, body only.</p>
                </Card>
            </div>
        </div>

        <h3 class="mb-3">Breadcrumbs</h3>
        <div class="mb-5">
            <BreadcrumbComponent Items="DemoCrumbs" />
        </div>

        <h3 class="mb-3">Form controls</h3>
        <div class="row mb-5">
            <div class="col-md-6">
                <FormText Label="Text field" Value="@textValue" ValueChanged="@(v => textValue = v)" />
                <FormSelect Label="Select" Value="@selectValue" Options="DemoOptions" ValueChanged="@(v => selectValue = v)" />
                <FormSwitch Label="Switch" Value="@switchValue" ValueChanged="@(v => switchValue = v)" />
            </div>
            <div class="col-md-6">
                <p class="small text-body-secondary">Live values</p>
                <ul class="small">
                    <li>Text: <code>@textValue</code></li>
                    <li>Select: <code>@selectValue</code></li>
                    <li>Switch: <code>@switchValue</code></li>
                </ul>
            </div>
        </div>

        <h3 class="mb-3">Overlays</h3>
        <div class="d-flex gap-2 mb-5">
            <Button Color="primary" OnClick="() => modalVisible = true">Open modal</Button>
            <Button Color="danger" OnClick="() => confirmVisible = true">Open confirm dialog</Button>
        </div>

        <Modal Title="Example modal" Visible="modalVisible" OnClose="() => modalVisible = false">
            <ChildContent>
                <p class="mb-0">This is the reusable CoreUI Modal, restyled to the Blogzine theme.</p>
            </ChildContent>
            <FooterContent>
                <Button Color="secondary" OnClick="() => modalVisible = false">Close</Button>
            </FooterContent>
        </Modal>

        <ConfirmDialog Visible="confirmVisible"
                       Title="Are you sure?"
                       Message="This is the reusable ConfirmDialog component."
                       OnConfirm="() => confirmVisible = false"
                       OnCancel="() => confirmVisible = false" />
    </div>
</section>

@code {
    private string? textValue = "Hello";
    private string? selectValue = "2";
    private bool switchValue = true;
    private bool modalVisible;
    private bool confirmVisible;

    private static readonly BreadcrumbItem[] DemoCrumbs = new[]
    {
        new BreadcrumbItem("Library", "#"),
        new BreadcrumbItem("Components", "#", IsActive: true),
    };

    private readonly IReadOnlyList<SelectOption> DemoOptions = new List<SelectOption>
    {
        new SelectOption { Value = "1", Text = "Option one" },
        new SelectOption { Value = "2", Text = "Option two" },
        new SelectOption { Value = "3", Text = "Option three" },
    };
}
