@page "/Checkout"
@rendermode InteractiveServer
@implements IDisposable
@inject ICartService CartService

@* InteractiveServer: reflects the live cart total; "Place order" clears the cart (demo only —
   no payment is taken). *@

<PageTitle>Checkout — Glory 2 Him</PageTitle>

<PageHeaderComponent Title="Checkout" ParentTitle="Shop" ParentHref="Shop-Grid" />

<section class="pt-4 pb-5">
    <div class="container">
        @if (OrderPlaced)
        {
            <div class="text-center py-5">
                <i class="bi bi-check-circle display-1 text-success"></i>
                <h2 class="mt-3">Thank you!</h2>
                <p class="mb-4">
                    This is a demo checkout — no payment was taken. In a real store your order
                    would be confirmed here.
                </p>
                <a href="Shop-Grid" class="btn btn-primary">Continue shopping</a>
            </div>
        }
        else if (CartService.IsEmpty)
        {
            <div class="alert alert-info" role="alert">
                Your cart is empty. <a href="Shop-Grid" class="alert-link">Browse the shop</a> first.
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card card-body border">
                        <h5 class="mb-3">Billing details</h5>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label" for="co-first">First name</label>
                                <input class="form-control" id="co-first" placeholder="First name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="co-last">Last name</label>
                                <input class="form-control" id="co-last" placeholder="Last name" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="co-email">Email</label>
                                <input type="email" class="form-control" id="co-email" placeholder="you@example.com" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="co-address">Address</label>
                                <input class="form-control" id="co-address" placeholder="Street address" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card card-body border">
                        <h5 class="mb-3">Your order</h5>
                        @foreach (CartItem item in CartService.Items)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.Product.Name × @item.Quantity</span>
                                <span>@item.LineTotal.ToString("C")</span>
                            </div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span class="h6 mb-0">Total</span>
                            <span class="h6 mb-0">@CartService.Subtotal.ToString("C")</span>
                        </div>
                        <button class="btn btn-primary" @onclick="PlaceOrder">Place order</button>
                        <p class="small text-body-secondary mt-2 mb-0">
                            Demo only — this will not charge any payment method.
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool OrderPlaced { get; set; }

    protected override void OnInitialized() => CartService.OnChanged += StateHasChanged;

    private void PlaceOrder()
    {
        OrderPlaced = true;
        CartService.Clear();
    }

    public void Dispose() => CartService.OnChanged -= StateHasChanged;
}
