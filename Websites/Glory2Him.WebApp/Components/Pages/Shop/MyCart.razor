@page "/My-Cart"
@rendermode InteractiveServer
@implements IDisposable
@inject ICartService CartService

@* InteractiveServer: quantity/remove operations mutate the live cart. *@

<PageTitle>My cart — Glory 2 Him</PageTitle>

<PageHeaderComponent Title="My cart" ParentTitle="Shop" ParentHref="Shop-Grid" />

<section class="pt-4 pb-5">
    <div class="container">
        @if (CartService.IsEmpty)
        {
            <div class="text-center py-5">
                <i class="bi bi-cart-x display-1 text-body-secondary"></i>
                <h2 class="mt-3">Your cart is empty</h2>
                <p class="mb-4">Looks like you have not added anything to your cart yet.</p>
                <a href="Shop-Grid" class="btn btn-primary">Continue shopping</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th style="width:150px">Quantity</th>
                                    <th class="text-end">Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (CartItem item in CartService.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name" style="width:56px" class="rounded me-3" />
                                                <a href="Shop-Detail/@item.Product.Slug" class="h6 mb-0">@item.Product.Name</a>
                                            </div>
                                        </td>
                                        <td>@item.Product.Price.ToString("C")</td>
                                        <td>
                                            <div class="input-group input-group-sm" style="max-width:120px">
                                                <button class="btn btn-outline-secondary" @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity - 1)">-</button>
                                                <input class="form-control text-center" type="text" value="@item.Quantity" readonly />
                                                <button class="btn btn-outline-secondary" @onclick="() => CartService.UpdateQuantity(item.Product.Id, item.Quantity + 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end">@item.LineTotal.ToString("C")</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CartService.Remove(item.Product.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <button class="btn btn-link text-danger p-0" @onclick="() => CartService.Clear()">Clear cart</button>
                </div>

                <div class="col-lg-4">
                    <div class="card card-body border">
                        <h5 class="mb-3">Order summary</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (@CartService.Count items)</span>
                            <strong>@CartService.Subtotal.ToString("C")</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-3 text-body-secondary">
                            <span>Shipping</span><span>Free</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span class="h6 mb-0">Total</span>
                            <span class="h6 mb-0">@CartService.Subtotal.ToString("C")</span>
                        </div>
                        <a href="Checkout" class="btn btn-primary">Proceed to checkout</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    protected override void OnInitialized() => CartService.OnChanged += StateHasChanged;

    public void Dispose() => CartService.OnChanged -= StateHasChanged;
}
