@page "/SamplePages/Lifestyle"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* The Blogzine "Lifestyle" category treatment: a featured hero, the category grid and the topic
   pill row from its mega-menu panel — plus the mega menu itself, demonstrated live in the strip
   below so the dropdown behaviour can be seen rather than just described. *@

<PageTitle>Lifestyle — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Lifestyle" SourceFile="categories.html + mega menu">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No posts have been published yet.</div>
    }
    else
    {
        @* The mega menu is a nav-item, so it needs a navbar around it to open correctly. *@
        <nav class="navbar navbar-expand-lg border-bottom py-0">
            <div class="container">
                <span class="small text-body-secondary me-3">Mega menu demo:</span>
                <ul class="navbar-nav">
                    <MegaMenuComponent Title="Lifestyle" Posts="Take(4)" Topics="Topics" />
                </ul>
            </div>
        </nav>

        <section class="pt-4">
            <div class="container">
                <PostOverlayCardComponent Post="Lead" TitleCssClass="display-6" />
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
                    <h2 class="h4 mb-0">In Lifestyle</h2>
                    <ul class="list-inline mb-0">
                        @foreach (string topic in Topics)
                        {
                            <li class="list-inline-item">
                                <a href="Tag?name=@Uri.EscapeDataString(topic)"
                                   class="btn btn-sm btn-primary-soft">@topic</a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="row g-4">
                            @foreach (PostView post in Fill(6))
                            {
                                <div class="col-sm-6">
                                    <PostCardComponent Post="post" ShowExcerpt="true" />
                                </div>
                            }
                        </div>

                        <div class="mt-4">
                            <PaginationComponent CurrentPage="1" TotalPages="3"
                                                 Variant="PaginationVariant.Rounded" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <BlogSidebarComponent TrendingPosts="Take(4)" Topics="Topics" />
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>

@code {
    private static readonly string[] Topics =
        new[] { "Faith", "Hope", "Prayer", "Scripture", "Testimony", "Worship", "Community" };
}
