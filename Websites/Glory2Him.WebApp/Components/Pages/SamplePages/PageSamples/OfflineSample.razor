@page "/SamplePages/Pages/Offline"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared

@* Blogzine offline.html: the no-connection state. *@

<PageTitle>Offline — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Offline" SourceFile="offline.html">
    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-7">
                    <i class="bi bi-wifi-off display-1 text-body-secondary"></i>
                    <h1 class="h2 mt-4 mb-3">You are offline</h1>
                    <p class="lead text-body-secondary mb-4">
                        We could not reach the network. Check your connection and try again — your
                        place in the journal is safe.
                    </p>

                    <a href="/" class="btn btn-primary">
                        <i class="bi bi-arrow-clockwise me-1"></i>Try again
                    </a>
                </div>
            </div>
        </div>
    </section>
</SampleShellComponent>
