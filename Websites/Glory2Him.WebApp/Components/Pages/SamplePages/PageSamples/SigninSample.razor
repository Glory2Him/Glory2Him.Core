@page "/SamplePages/Pages/Signin"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared

@* Blogzine signin.html. A layout demo only — the real sign-in lives at /Account/Login. *@

<PageTitle>Signin — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Signin" SourceFile="signin.html">
    <AuthCardComponent Title="Welcome back"
                       Subtitle="Sign in to pick up where you left off."
                       FooterPrompt="New here?"
                       FooterLinkText="Create an account"
                       FooterHref="SamplePages/Pages/Signup">
        <FormText Label="Email address" Placeholder="jane@example.com" />
        <FormText Label="Password" Placeholder="••••••••" />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <FormSwitch Label="Keep me signed in" Value="true" />
            <a href="Account/ForgotPassword" class="btn-link small">Forgot password?</a>
        </div>

        <div class="d-grid">
            <Button Color="primary">Sign me in</Button>
        </div>
    </AuthCardComponent>
</SampleShellComponent>
