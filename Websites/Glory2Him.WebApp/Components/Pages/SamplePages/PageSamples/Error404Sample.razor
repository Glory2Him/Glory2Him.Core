@page "/SamplePages/Pages/Error-404"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared

@* Blogzine 404.html: oversized code, a short apology and the way back. *@

<PageTitle>Error 404 — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Error 404" SourceFile="404.html">
    <section class="py-5">
        <div class="container">
            <div class="row justify-content-center text-center">
                <div class="col-lg-7">
                    <h1 class="display-1 fw-bold text-primary mb-0">404</h1>
                    <h2 class="h3 mb-3">We could not find that page</h2>
                    <p class="lead text-body-secondary mb-4">
                        The link may be broken, or the page may have moved. Let's get you back to
                        something worth reading.
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-house me-1"></i>Back to home
                        </a>
                        <a href="Categories" class="btn btn-outline-secondary">
                            Browse the journal
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</SampleShellComponent>
