@page "/SamplePages"
@layout Glory2Him.WebApp.Components.Layout.SidebarLayout
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Navigation
@using Glory2Him.WebApp.Models.Views.Navigations

@* Catalogue of every layout demo. Sits in the admin shell (SidebarLayout) rather than full width,
   so the sample pages' "Back to Sample Pages" button lands you back in the admin area with the
   navigation still on the left. The tree is read straight from NavMenuProvider so this page and
   the sidebar can never drift apart. Statically rendered — it is a list of links. *@

<PageTitle>Sample Pages — Glory 2 Him</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sample Pages</h1>
    <BreadcrumbComponent Items="Crumbs" />
</div>
<hr />

<div class="alert alert-info d-flex align-items-start" role="alert">
    <i class="bi bi-info-circle me-2 mt-1"></i>
    <div>
        Layout demos ported from the Blogzine template, rendered full width inside the Glory 2 Him
        header and footer. Use the <strong>Back to Sample Pages</strong> button on any demo to
        return here.
    </div>
</div>

<div class="row g-4">
    @foreach (NavItem group in Groups)
    {
        <div class="col-md-6 col-xxl-4">
            <Card CssClass="h-100">
                <HeaderContent>
                    <span class="d-flex align-items-center">
                        <i class="bi @group.Icon me-2"></i>@group.Title
                    </span>
                </HeaderContent>
                <ChildContent>
                    <ul class="list-unstyled mb-0">
                        @foreach (NavItem leaf in Flatten(group))
                        {
                            <li class="mb-2 d-flex align-items-center">
                                <i class="bi bi-dot me-1 opacity-50"></i>
                                <a href="@leaf.Href" class="text-reset btn-link">@leaf.Title</a>
                            </li>
                        }
                    </ul>
                </ChildContent>
            </Card>
        </div>
    }
</div>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Sample Pages", "SamplePages", IsActive: true),
    };

    private static IReadOnlyList<NavItem> Groups =>
        NavMenuProvider.GetSamplePagesSection().Children ?? Array.Empty<NavItem>();

    // Post nests one level deeper (Post Grid), so flatten to the leaves — the catalogue lists
    // every reachable demo rather than mirroring the sidebar's nesting.
    private static IEnumerable<NavItem> Flatten(NavItem item)
    {
        if (!item.HasChildren)
        {
            yield return item;

            yield break;
        }

        foreach (NavItem child in item.Children!)
        {
            foreach (NavItem leaf in Flatten(child))
            {
                yield return leaf;
            }
        }
    }
}
