@page "/SamplePages/Home/Magazine"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine index-3.html: a dense magazine front page — full-bleed hero, a four-across strip, then
   a two-column main + sidebar split. *@

<PageTitle>Magazine — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Magazine" SourceFile="index-3.html">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No posts have been published yet.</div>
    }
    else
    {
        <section class="pt-4">
            <div class="container">
                <div class="row g-4">
                    <div class="col-12">
                        <PostOverlayCardComponent Post="Lead" TitleCssClass="display-6" />
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="row g-4 mb-5">
                    @foreach (PostView post in Fill(4))
                    {
                        <div class="col-sm-6 col-lg-3">
                            <PostCardComponent Post="post" />
                        </div>
                    }
                </div>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <h2 class="h4 mb-4">Editor's picks</h2>

                        <div class="row g-4">
                            @foreach (PostView post in Fill(4))
                            {
                                <div class="col-md-6">
                                    <PostCardComponent Post="post" ShowExcerpt="true" />
                                </div>
                            }
                        </div>

                        <hr class="my-4" />

                        @foreach (PostView post in Take(3))
                        {
                            <PostListItemComponent Post="post" />
                        }
                    </div>

                    <div class="col-lg-4">
                        <BlogSidebarComponent TrendingPosts="Take(4)" />
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>
