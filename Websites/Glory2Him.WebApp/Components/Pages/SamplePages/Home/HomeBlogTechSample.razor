@page "/SamplePages/Home/Blog-Tech"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine index-8.html: the tech front page — a category strip, a large lead beside a compact
   list, then an even grid. *@

<PageTitle>Blog Tech — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Blog Tech" SourceFile="index-8.html">
    <section class="pt-4 pb-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else if (Lead is null)
            {
                <div class="alert alert-info" role="alert">No posts have been published yet.</div>
            }
            else
            {
                <ul class="list-inline mb-4">
                    @foreach (string topic in Topics)
                    {
                        <li class="list-inline-item mb-2">
                            <a href="Tag?name=@Uri.EscapeDataString(topic)"
                               class="btn btn-sm btn-primary-soft">@topic</a>
                        </li>
                    }
                </ul>

                <div class="row g-4 mb-5">
                    <div class="col-lg-8">
                        <PostLargeCardComponent Post="Lead" TitleCssClass="h3" />
                    </div>
                    <div class="col-lg-4">
                        <Card CssClass="border h-100">
                            <HeaderContent>Also this week</HeaderContent>
                            <ChildContent>
                                @foreach (PostView post in AfterLead.Take(4))
                                {
                                    <div class="d-flex gap-3 mb-3 position-relative">
                                        <img class="rounded flex-shrink-0" src="@post.ImageUrl"
                                             alt="@post.Title"
                                             style="width:64px;height:64px;object-fit:cover;" />
                                        <div>
                                            <h6 class="mb-1">
                                                <a href="Post-Single/@post.Slug"
                                                   class="btn-link text-reset stretched-link">@post.Title</a>
                                            </h6>
                                            <small class="text-body-secondary">
                                                @post.PublishedDate.ToString("MMM dd, yyyy")
                                            </small>
                                        </div>
                                    </div>
                                }
                            </ChildContent>
                        </Card>
                    </div>
                </div>

                <h2 class="h4 mb-4">More from the journal</h2>

                <div class="row g-4">
                    @foreach (PostView post in Fill(8))
                    {
                        <div class="col-sm-6 col-lg-3">
                            <PostCardComponent Post="post" />
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly string[] Topics =
        new[] { "Faith", "Hope", "Prayer", "Scripture", "Testimony", "Worship", "Community" };
}
