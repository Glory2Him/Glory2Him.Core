@page "/SamplePages/Home/Blog-Classic"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine index-5.html: the classic blog roll — one wide post after another down the main
   column, with the sidebar alongside. *@

<PageTitle>Blog Classic — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Blog Classic" SourceFile="index-5.html">
    <HeroBannerComponent Title="Blog Classic" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else if (!Posts.Any())
            {
                <div class="alert alert-info" role="alert">No posts have been published yet.</div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="vstack gap-4">
                            @foreach (PostView post in Posts)
                            {
                                <PostLargeCardComponent Post="post" />
                            }
                        </div>

                        <div class="mt-5">
                            <PaginationComponent CurrentPage="1" TotalPages="3" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <BlogSidebarComponent TrendingPosts="Take(4)" />
                    </div>
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Blog Classic", IsActive: true),
    };
}
