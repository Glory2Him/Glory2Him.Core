@page "/SamplePages/Home/Blog-Podcast"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine index-10.html: the podcast front page — a featured episode over the hero, then the
   episode list. *@

<PageTitle>Blog Podcast — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Blog Podcast" SourceFile="index-10.html">
    <HeroBannerComponent Title="The Glory 2 Him Podcast" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else if (Lead is null)
            {
                <div class="alert alert-info" role="alert">No episodes have been published yet.</div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-lg-8">
                        <h2 class="h4 mb-4">Latest episodes</h2>

                        <div class="vstack gap-3">
                            @foreach ((PostView post, string duration) in EpisodesWithDurations)
                            {
                                <PodcastCardComponent Post="post" Duration="@duration" />
                            }
                        </div>

                        <div class="mt-5">
                            <PaginationComponent CurrentPage="1" TotalPages="4"
                                                 Variant="PaginationVariant.Rounded" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <BlogSidebarComponent TrendingPosts="Take(4)" ShowAbout="true" />
                    </div>
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Podcast", IsActive: true),
    };

    // Durations are demo dressing rather than stored data, so they are paired here instead of
    // being pushed onto PostView.
    private static readonly string[] Durations =
        new[] { "18:42", "26:05", "41:19", "33:57", "12:30", "48:11" };

    private IEnumerable<(PostView Post, string Duration)> EpisodesWithDurations =>
        Posts.Select((post, index) => (post, Durations[index % Durations.Length]));
}
