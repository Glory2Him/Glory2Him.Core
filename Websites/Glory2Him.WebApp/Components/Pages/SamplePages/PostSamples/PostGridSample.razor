@page "/SamplePages/Post/Post-Grid/Post-Grid"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-grid.html: an even three-across grid. *@

<PageTitle>Post Grid — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Grid" SourceFile="post-grid.html">
    <HeroBannerComponent Title="Post grid" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (PostView post in Fill(9))
                    {
                        <div class="col-sm-6 col-lg-4">
                            <PostCardComponent Post="post" ShowExcerpt="true" />
                        </div>
                    }
                </div>

                <div class="mt-5">
                    <PaginationComponent CurrentPage="1" TotalPages="3" />
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("All posts", IsActive: true),
    };
}
