@page "/SamplePages/Post/Podcast-Single"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine podcast-single.html: one episode — cover art, transport bar, show notes and the rest
   of the series. The transport is a placeholder; no audio is wired up in these demos. *@

<PageTitle>Podcast Single — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Podcast Single" SourceFile="podcast-single.html">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No episodes have been published yet.</div>
    }
    else
    {
        <section class="py-5">
            <div class="container">
                <div class="row g-4 align-items-center mb-5">
                    <div class="col-md-4">
                        <img class="rounded w-100" src="@Lead.ImageUrl" alt="@Lead.Title"
                             style="aspect-ratio:1/1;object-fit:cover;" />
                    </div>

                    <div class="col-md-8">
                        <a href="Categories" class="badge @Lead.CategoryBadgeCss mb-2">
                            @Lead.Category
                        </a>

                        <h1 class="h2 mb-2">@Lead.Title</h1>

                        <ul class="nav nav-divider align-items-center small mb-4">
                            <li class="nav-item">Episode 12</li>
                            <li class="nav-item">@Lead.PublishedDate.ToString("MMMM dd, yyyy")</li>
                            <li class="nav-item">32:10</li>
                        </ul>

                        <div class="card border">
                            <div class="card-body d-flex align-items-center gap-3">
                                <Button Color="primary" CssClass="rounded-circle lh-1 p-3">
                                    <i class="bi bi-play-fill fs-4"></i>
                                </Button>

                                <div class="flex-grow-1">
                                    <div class="progress" style="height:6px;" role="progressbar"
                                         aria-label="Episode progress" aria-valuenow="35"
                                         aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar bg-primary" style="width:35%;"></div>
                                    </div>
                                    <div class="d-flex justify-content-between small text-body-secondary mt-1">
                                        <span>11:15</span>
                                        <span>32:10</span>
                                    </div>
                                </div>

                                <i class="bi bi-volume-up fs-5 text-body-secondary"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-lg-8">
                        <h2 class="h4 mb-3">Show notes</h2>
                        <SampleArticleBodyComponent Post="Lead" />
                    </div>

                    <div class="col-lg-4">
                        <h2 class="h4 mb-3">More episodes</h2>
                        <div class="vstack gap-3">
                            @foreach (PostView post in AfterLead.Take(4))
                            {
                                <PodcastCardComponent Post="post" />
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>
