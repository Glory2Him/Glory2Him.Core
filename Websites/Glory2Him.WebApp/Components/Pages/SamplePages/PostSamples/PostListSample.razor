@page "/SamplePages/Post/Post-List"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-list.html: horizontal rows down the main column, sidebar alongside. *@

<PageTitle>Post List — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post List" SourceFile="post-list.html">
    <HeroBannerComponent Title="Post list" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else
            {
                <div class="row g-4">
                    <div class="col-lg-8">
                        @foreach (PostView post in Posts)
                        {
                            <PostListItemComponent Post="post" />
                        }

                        <div class="mt-4">
                            <PaginationComponent CurrentPage="1" TotalPages="3" />
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <BlogSidebarComponent TrendingPosts="Take(4)" />
                    </div>
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("All posts", IsActive: true),
    };
}
