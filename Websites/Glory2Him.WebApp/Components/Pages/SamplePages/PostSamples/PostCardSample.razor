@page "/SamplePages/Post/Post-Card"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-cards.html: the plain card treatment at three sizes, so the same component can be
   compared across column widths. *@

<PageTitle>Post Card — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Card" SourceFile="post-cards.html">
    <HeroBannerComponent Title="Post cards" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else
            {
                <h2 class="h5 mb-3">Two across, with excerpt</h2>
                <div class="row g-4 mb-5">
                    @foreach (PostView post in Take(2))
                    {
                        <div class="col-md-6">
                            <PostCardComponent Post="post" ShowExcerpt="true" />
                        </div>
                    }
                </div>

                <h2 class="h5 mb-3">Three across</h2>
                <div class="row g-4 mb-5">
                    @foreach (PostView post in Take(3))
                    {
                        <div class="col-sm-6 col-lg-4">
                            <PostCardComponent Post="post" />
                        </div>
                    }
                </div>

                <h2 class="h5 mb-3">Four across</h2>
                <div class="row g-4">
                    @foreach (PostView post in Fill(4))
                    {
                        <div class="col-sm-6 col-lg-3">
                            <PostCardComponent Post="post" />
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Post cards", IsActive: true),
    };
}
