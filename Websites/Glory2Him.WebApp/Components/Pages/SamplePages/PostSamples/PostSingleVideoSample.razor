@page "/SamplePages/Post/Post-Single-Video"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-single-6.html: a video sits where the hero image usually would. The frame is a
   placeholder — no third-party player is embedded in these demos. *@

<PageTitle>Post Single Video — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Single Video" SourceFile="post-single-6.html">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No posts have been published yet.</div>
    }
    else
    {
        <section class="py-5">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="position-relative rounded overflow-hidden mb-4">
                            <img class="w-100" src="@Lead.ImageUrl" alt="@Lead.Title"
                                 style="max-height:460px;object-fit:cover;" />

                            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                                 style="background:rgba(10,12,20,0.45);">
                                <Button Color="light" CssClass="rounded-circle p-3 lh-1">
                                    <i class="bi bi-play-fill fs-1"></i>
                                </Button>
                            </div>

                            <span class="position-absolute top-0 end-0 m-3">
                                <PostTypeBadgeComponent Type="PostType.Video" />
                            </span>
                        </div>

                        <a href="Categories" class="badge @Lead.CategoryBadgeCss mb-3">
                            @Lead.Category
                        </a>

                        <h1 class="h2 mb-3">@Lead.Title</h1>

                        <ul class="nav nav-divider align-items-center small mb-4">
                            <li class="nav-item">by @Lead.AuthorName</li>
                            <li class="nav-item">@Lead.PublishedDate.ToString("MMMM dd, yyyy")</li>
                            <li class="nav-item">12:04 watch</li>
                        </ul>

                        <SampleArticleBodyComponent Post="Lead" />
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>
