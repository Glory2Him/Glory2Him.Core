@page "/SamplePages/Post/Post-Grid/Post-Grid-Masonry"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-grid-masonry.html: masonry with no filter bar. Uses the isotope vendor library
   already loaded by App.razor — it initialises on DOMContentLoaded, which is why this site
   navigates with full document loads (see App.razor). *@

<PageTitle>Post Grid Masonry — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Grid Masonry" SourceFile="post-grid-masonry.html">
    <HeroBannerComponent Title="Post grid masonry" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else
            {
                <div class="row filter-container overflow-hidden"
                     data-isotope='{"layoutMode": "masonry"}'>
                    @foreach (PostView post in Fill(9))
                    {
                        <div class="col-sm-6 col-lg-4 grid-item mb-4">
                            <PostCardComponent Post="post" ShowExcerpt="true" />
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("All posts", IsActive: true),
    };
}
