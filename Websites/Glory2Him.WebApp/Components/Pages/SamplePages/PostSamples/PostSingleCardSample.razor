@page "/SamplePages/Post/Post-Single-Card"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-single-4.html: the article floats in a raised card over a tinted background. *@

<PageTitle>Post Single Card — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Single Card" SourceFile="post-single-4.html">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No posts have been published yet.</div>
    }
    else
    {
        <section class="py-5 bg-body-tertiary">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="card border shadow-sm overflow-hidden">
                            <img class="card-img-top" src="@Lead.ImageUrl" alt="@Lead.Title"
                                 style="max-height:400px;object-fit:cover;" />

                            <div class="card-body p-4 p-lg-5">
                                <a href="Categories" class="badge @Lead.CategoryBadgeCss mb-3">
                                    @Lead.Category
                                </a>

                                <h1 class="h2 mb-3">@Lead.Title</h1>

                                <ul class="nav nav-divider align-items-center small mb-4">
                                    <li class="nav-item">by @Lead.AuthorName</li>
                                    <li class="nav-item">
                                        @Lead.PublishedDate.ToString("MMMM dd, yyyy")
                                    </li>
                                    <li class="nav-item">@Lead.ReadMinutes min read</li>
                                </ul>

                                <SampleArticleBodyComponent Post="Lead" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>
