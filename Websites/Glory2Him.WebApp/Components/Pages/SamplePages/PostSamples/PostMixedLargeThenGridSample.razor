@page "/SamplePages/Post/Post-Grid/Post-Mixed-Large-Then-Grid"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-large-and-grid.html: a wide lead story, then the rest as a regular grid. *@

<PageTitle>Post Mixed Large Then Grid — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Mixed Large Then Grid" SourceFile="post-large-and-grid.html">
    <HeroBannerComponent Title="Large post, then grid" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else if (Lead is null)
            {
                <div class="alert alert-info" role="alert">No posts have been published yet.</div>
            }
            else
            {
                <div class="mb-5">
                    <PostLargeCardComponent Post="Lead" TitleCssClass="h2" />
                </div>

                <div class="row g-4">
                    @foreach (PostView post in AfterLead)
                    {
                        <div class="col-sm-6 col-lg-4">
                            <PostCardComponent Post="post" ShowExcerpt="true" />
                        </div>
                    }
                </div>

                <div class="mt-5">
                    <PaginationComponent CurrentPage="1" TotalPages="2"
                                         Variant="PaginationVariant.PrevNext" />
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("All posts", IsActive: true),
    };
}
