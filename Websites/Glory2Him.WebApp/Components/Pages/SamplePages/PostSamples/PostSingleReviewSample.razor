@page "/SamplePages/Post/Post-Single-Review"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-single-5.html: the review layout — article beside a scorecard, verdict at the
   end. *@

<PageTitle>Post Single Review — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Single Review" SourceFile="post-single-5.html">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No posts have been published yet.</div>
    }
    else
    {
        <HeroBannerComponent Title="@Lead.Title" ImageUrl="@Lead.ImageUrl" Crumbs="Crumbs" />

        <section class="py-5">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-8">
                        <SampleArticleBodyComponent Post="Lead" />

                        <div class="alert alert-primary mt-4" role="alert">
                            <h3 class="h5 alert-heading">The verdict</h3>
                            <p class="mb-0">
                                Worth your time. It rewards a slow read, and the closing chapter
                                lands harder than the opening promises.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="mb-4">
                            <ReviewRatingComponent OverallScore="4.5"
                                                   Summary="Excellent — a rare, generous book."
                                                   Criteria="Criteria" />
                        </div>

                        <BlogSidebarComponent TrendingPosts="Take(3)" ShowAbout="false" />
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Review", IsActive: true),
    };

    private static readonly ReviewCriterion[] Criteria = new[]
    {
        new ReviewCriterion("Writing", 4.8),
        new ReviewCriterion("Pacing", 4.1),
        new ReviewCriterion("Depth", 4.6),
        new ReviewCriterion("Value", 4.4),
    };
}
