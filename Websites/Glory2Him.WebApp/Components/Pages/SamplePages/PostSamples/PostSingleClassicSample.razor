@page "/SamplePages/Post/Post-Single-Classic"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-single-2.html: headline above a standard image, article and sidebar below. *@

<PageTitle>Post Single Classic — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Single Classic" SourceFile="post-single-2.html">
    @if (IsLoading)
    {
        <div class="text-center py-5"><Spinner /></div>
    }
    else if (HasError)
    {
        <div class="alert alert-danger m-4" role="alert">@ErrorMessage</div>
    }
    else if (Lead is null)
    {
        <div class="alert alert-info m-4" role="alert">No posts have been published yet.</div>
    }
    else
    {
        <section class="pt-5 pb-4">
            <div class="container">
                <div class="row justify-content-center text-center">
                    <div class="col-lg-9">
                        <a href="Categories" class="badge @Lead.CategoryBadgeCss mb-3">
                            @Lead.Category
                        </a>
                        <h1 class="display-6 mb-3">@Lead.Title</h1>

                        <ul class="nav nav-divider align-items-center justify-content-center mb-0">
                            <li class="nav-item">
                                <div class="nav-link">
                                    <AvatarComponent Name="@Lead.AuthorName"
                                                     ImageUrl="@Lead.AuthorImageUrl" SizePx="28" />
                                </div>
                            </li>
                            <li class="nav-item">by @Lead.AuthorName</li>
                            <li class="nav-item">@Lead.PublishedDate.ToString("MMMM dd, yyyy")</li>
                            <li class="nav-item">@Lead.ReadMinutes min read</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="pb-5">
            <div class="container">
                <img class="rounded w-100 mb-5" src="@Lead.ImageUrl" alt="@Lead.Title"
                     style="max-height:480px;object-fit:cover;" />

                <div class="row g-4">
                    <div class="col-lg-8">
                        <SampleArticleBodyComponent Post="Lead" />
                    </div>
                    <div class="col-lg-4">
                        <BlogSidebarComponent TrendingPosts="Take(4)" />
                    </div>
                </div>
            </div>
        </section>
    }
</SampleShellComponent>
