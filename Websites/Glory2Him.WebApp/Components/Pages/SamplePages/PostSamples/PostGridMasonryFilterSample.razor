@page "/SamplePages/Post/Post-Grid/Post-Grid-Masonry-Filter"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-grid-masonry-filter.html: masonry plus the category filter pills isotope drives. *@

<PageTitle>Post Grid Masonry Filter — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Grid Masonry Filter" SourceFile="post-grid-masonry-filter.html">
    <HeroBannerComponent Title="Post grid masonry filter" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else if (!Posts.Any())
            {
                <div class="alert alert-info" role="alert">No posts have been published yet.</div>
            }
            else
            {
                <div class="row">
                    <div class="col-12">
                        <div class="grid-menu" data-target=".filter-container">
                            <ul class="nav nav-pills justify-content-start mb-3">
                                <li class="nav-item">
                                    <span class="nav-link disabled ps-0">Show me:</span>
                                </li>
                                <li class="nav-item">
                                    <a data-filter="*" class="nav-link active">All posts</a>
                                </li>
                                @foreach (string category in Categories)
                                {
                                    <li class="nav-item">
                                        <a data-filter=".@CategoryClass(category)" class="nav-link">
                                            @category
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="row filter-container overflow-hidden"
                     data-isotope='{"layoutMode": "masonry"}'>
                    @foreach (PostView post in Posts)
                    {
                        <div class="col-sm-6 col-lg-4 grid-item mb-4 @CategoryClass(post.Category)">
                            <PostCardComponent Post="post" ShowExcerpt="true" />
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("All posts", IsActive: true),
    };

    private IEnumerable<string> Categories =>
        Posts.Select(post => post.Category)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category);

    // isotope filters on a CSS class per category (e.g. "Faith" -> "faith-category").
    private static string CategoryClass(string category) =>
        category.ToLowerInvariant().Replace(" ", "-") + "-category";
}
