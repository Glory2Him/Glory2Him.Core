@page "/SamplePages/Post/Pagination-Styles"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared

@* Blogzine pagination-styles.html: every pagination variant side by side.
   InteractiveServer because these controls are live — clicking a page actually moves them. *@

<PageTitle>Pagination Styles — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Pagination Styles" SourceFile="pagination-styles.html">
    <HeroBannerComponent Title="Pagination styles" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-6">
                    <Card CssClass="border h-100">
                        <HeaderContent>Numbered</HeaderContent>
                        <ChildContent>
                            <p class="text-body-secondary small">
                                Square links with chevrons either side. Currently on page
                                <strong>@numberedPage</strong>.
                            </p>
                            <PaginationComponent CurrentPage="numberedPage"
                                                 CurrentPageChanged="value => numberedPage = value"
                                                 TotalPages="5" />
                        </ChildContent>
                    </Card>
                </div>

                <div class="col-lg-6">
                    <Card CssClass="border h-100">
                        <HeaderContent>Rounded</HeaderContent>
                        <ChildContent>
                            <p class="text-body-secondary small">
                                The same control with pill-shaped links. Currently on page
                                <strong>@roundedPage</strong>.
                            </p>
                            <PaginationComponent CurrentPage="roundedPage"
                                                 CurrentPageChanged="value => roundedPage = value"
                                                 TotalPages="5"
                                                 Variant="PaginationVariant.Rounded" />
                        </ChildContent>
                    </Card>
                </div>

                <div class="col-lg-6">
                    <Card CssClass="border h-100">
                        <HeaderContent>Previous / next only</HeaderContent>
                        <ChildContent>
                            <p class="text-body-secondary small">
                                No page numbers — useful for long article series. Currently on page
                                <strong>@prevNextPage</strong>.
                            </p>
                            <PaginationComponent CurrentPage="prevNextPage"
                                                 CurrentPageChanged="value => prevNextPage = value"
                                                 TotalPages="5"
                                                 Variant="PaginationVariant.PrevNext" />
                        </ChildContent>
                    </Card>
                </div>

                <div class="col-lg-6">
                    <Card CssClass="border h-100">
                        <HeaderContent>Left aligned</HeaderContent>
                        <ChildContent>
                            <p class="text-body-secondary small">
                                Centring turned off so the control sits with the content.
                            </p>
                            <PaginationComponent CurrentPage="alignedPage"
                                                 CurrentPageChanged="value => alignedPage = value"
                                                 TotalPages="3"
                                                 Alignment="false" />
                        </ChildContent>
                    </Card>
                </div>
            </div>
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Pagination styles", IsActive: true),
    };

    private int numberedPage = 1;
    private int roundedPage = 2;
    private int prevNextPage = 1;
    private int alignedPage = 1;
}
