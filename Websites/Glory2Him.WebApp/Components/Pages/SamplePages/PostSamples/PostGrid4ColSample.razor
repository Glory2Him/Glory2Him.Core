@page "/SamplePages/Post/Post-Grid/Post-Grid-4-Col"
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine post-grid-4-col.html: the same grid at four across, so cards drop their excerpt. *@

<PageTitle>Post Grid 4 Col — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Post Grid 4 Col" SourceFile="post-grid-4-col.html">
    <HeroBannerComponent Title="Post grid 4 column" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else
            {
                <div class="row g-4">
                    @foreach (PostView post in Fill(12))
                    {
                        <div class="col-sm-6 col-lg-3">
                            <PostCardComponent Post="post" />
                        </div>
                    }
                </div>

                <div class="mt-5">
                    <PaginationComponent CurrentPage="2" TotalPages="4" />
                </div>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("All posts", IsActive: true),
    };
}
