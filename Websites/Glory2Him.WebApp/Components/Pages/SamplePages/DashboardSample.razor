@page "/SamplePages/Dashboard"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrators")]
@using Glory2Him.WebApp.Components.Pages.SamplePages.Shared
@inherits SamplePageBase

@* Blogzine dashboard.html: the author dashboard shown full width inside the site chrome rather
   than the admin shell. InteractiveServer because the Chart needs a circuit for its JS interop. *@

<PageTitle>Dashboard — Sample — Glory 2 Him</PageTitle>

<SampleShellComponent Title="Dashboard" SourceFile="dashboard.html">
    <HeroBannerComponent Title="Author dashboard" Crumbs="Crumbs" />

    <section class="py-5">
        <div class="container">
            @if (IsLoading)
            {
                <div class="text-center py-5"><Spinner /></div>
            }
            else if (HasError)
            {
                <div class="alert alert-danger" role="alert">@ErrorMessage</div>
            }
            else
            {
                <div class="row g-4 mb-4">
                    <div class="col-sm-6 col-lg-3">
                        <StatTile Variant="StatTileVariant.Green" Icon="bi-file-earmark-text-fill"
                                  Value="@Posts.Count.ToString()" Label="Posts" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <StatTile Variant="StatTileVariant.Na" Icon="bi-eye-fill"
                                  Value="8.2k" Label="Views" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <StatTile Variant="StatTileVariant.Amber" Icon="bi-star-fill"
                                  Value="@FeaturedCount.ToString()" Label="Featured" />
                    </div>
                    <div class="col-sm-6 col-lg-3">
                        <StatTile Variant="StatTileVariant.Red" Icon="bi-chat-heart-fill"
                                  Value="126" Label="Comments" />
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-xl-7">
                        <Card Title="Views this week">
                            <Chart ChartType="area" Labels="DayLabels" Datasets="ViewDatasets"
                                   Height="300" />
                        </Card>
                    </div>

                    <div class="col-xl-5">
                        <Card Title="Posts by category">
                            <Chart ChartType="donut" Labels="CategoryLabels"
                                   Datasets="CategoryDatasets" Height="300" />
                        </Card>
                    </div>
                </div>

                <Card Title="Recent posts">
                    <DataTable TItem="PostView" Items="Posts" Columns="Columns" PageSize="5" />
                </Card>
            }
        </div>
    </section>
</SampleShellComponent>

@code {
    private static readonly BreadcrumbItem[] Crumbs = new[]
    {
        new BreadcrumbItem("Dashboard", IsActive: true),
    };

    private int FeaturedCount =>
        Posts.Count(post => post.IsFeatured);

    private static readonly string[] DayLabels =
        new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    private static readonly ChartDataset[] ViewDatasets = new[]
    {
        new ChartDataset
        {
            Label = "Views",
            Data = new double[] { 820, 932, 901, 1290, 1330, 1120, 1420 },
        },
    };

    private IReadOnlyList<string> CategoryLabels =>
        Posts.Select(post => post.Category)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category)
            .ToList();

    private IReadOnlyList<ChartDataset> CategoryDatasets =>
        new[]
        {
            new ChartDataset
            {
                Label = "Posts",
                Data = CategoryLabels
                    .Select(category => (double)Posts.Count(post =>
                        string.Equals(post.Category, category, StringComparison.OrdinalIgnoreCase)))
                    .ToArray(),
            },
        };

    private readonly IReadOnlyList<DataTableColumn<PostView>> Columns =
        new List<DataTableColumn<PostView>>
        {
            new DataTableColumn<PostView> { Title = "Title", Value = post => post.Title },
            new DataTableColumn<PostView>
            {
                Title = "Category",
                Value = post => post.Category,
                CellTemplate = post =>
                    @<span class="badge @post.CategoryBadgeCss">@post.Category</span>,
            },
            new DataTableColumn<PostView> { Title = "Author", Value = post => post.AuthorName },
            new DataTableColumn<PostView>
            {
                Title = "Published",
                Value = post => post.PublishedDate,
                CellTemplate = post =>
                    @<span>@post.PublishedDate.ToString("MMM dd, yyyy")</span>,
            },
        };
}
