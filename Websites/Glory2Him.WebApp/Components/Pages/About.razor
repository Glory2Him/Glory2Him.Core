@page "/about-us"

<PageTitle>About — Glory 2 Him</PageTitle>

<PageHeaderComponent Title="About Glory 2 Him" />

<section class="pt-4 pb-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-10 mx-auto">
                <p class="lead">
                    Glory 2 Him exists to share the good news of Jesus Christ — to encourage,
                    to build up, and to point all glory back to Him.
                </p>
                <p>
                    This is a demo site built on the Blogzine theme. As we begin to model real
                    content, these sample pages will serve as templates for the stories,
                    reflections, and resources that follow.
                </p>
                <blockquote class="blockquote my-4">
                    <p class="mb-2">"Jesus answered, 'I am the way and the truth and the life. No one comes to the Father except through me.'"</p>
                    <footer class="blockquote-footer">John 14:6</footer>
                </blockquote>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <div class="col-md-4">
                <div class="card card-body h-100 text-center">
                    <i class="bi bi-book display-6 text-primary mb-2"></i>
                    <h5>Rooted in Scripture</h5>
                    <p class="mb-0">Everything we share is anchored in God's Word.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-body h-100 text-center">
                    <i class="bi bi-people display-6 text-primary mb-2"></i>
                    <h5>For the community</h5>
                    <p class="mb-0">Stories and encouragement to build one another up.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-body h-100 text-center">
                    <i class="bi bi-globe display-6 text-primary mb-2"></i>
                    <h5>Go and share</h5>
                    <p class="mb-0">"Go into all the world and preach the gospel." — Mark 16:15</p>
                </div>
            </div>
        </div>
    </div>
</section>
