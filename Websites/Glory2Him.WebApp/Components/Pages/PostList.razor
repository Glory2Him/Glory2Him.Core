@page "/Post-List"
@inherits CategoriesBase

@* Post list layout (Blogzine post-list.html) — reuses the shared posts loader + PostListItemComponent. *@

<PageTitle>Post list — Glory 2 Him</PageTitle>

<PageHeaderComponent Title="Post list" />

<section class="pt-4 pb-5">
    <div class="container">
        @if (IsLoading)
        {
            <div class="text-center py-5"><Spinner /></div>
        }
        else if (HasError)
        {
            <div class="alert alert-danger" role="alert">@ErrorMessage</div>
        }
        else if (!Posts.Any())
        {
            <div class="alert alert-info" role="alert">No posts have been published yet.</div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-10 mx-auto">
                    @foreach (PostView post in Posts)
                    {
                        <PostListItemComponent Post="post" />
                    }
                </div>
            </div>
        }
    </div>
</section>
