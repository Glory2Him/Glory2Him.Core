@inherits LayoutComponentBase
@layout Glory2Him.WebApp.Components.Layout.SidebarLayout
@using Glory2Him.WebApp.Components.CoreUI
@using Glory2Him.WebApp.Models.Views.Navigations

@* The account-management pages render inside the shared sidebar shell; the left menu already
   carries the "My Account" section, so this layout only adds the page heading + breadcrumb. *@

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage your account</h1>
    <BreadcrumbComponent Items="ManageCrumbs" />
</div>
<hr />

@Body

@code {
    private static readonly BreadcrumbItem[] ManageCrumbs = new[]
    {
        new BreadcrumbItem("My Account", "Account/Manage", IsActive: true),
    };
}
