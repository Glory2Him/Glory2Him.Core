@page "/Account/Register"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Glory2Him.WebApp.Data
@using Glory2Him.WebApp.Models.Foundations.Users
@using Glory2Him.WebApp.Services.Views.Registrations

@inject UserManager<AppUser> UserManager
@inject IUserStore<AppUser> UserStore
@inject IRegistrationViewService RegistrationViewService
@inject NavigationManager NavigationManager
@inject ILogger<Register> Logger

@* Interactive island: real-time username availability + suggestions and a friendly
   "email already registered" hint. On success it redirects to the login page (cookie sign-in
   needs a static request, so we do not auto-sign-in here). *@

<PageTitle>Sign up — Glory 2 Him</PageTitle>

<section class="py-4 py-lg-5">
    <div class="container">
        <div class="row">
            <div class="col-md-10 col-lg-8 col-xl-6 mx-auto">
                <div class="bg-primary bg-opacity-10 rounded p-4 p-sm-5">
                    <h2>Create your free account</h2>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
                    }

                    <EditForm Model="Input" OnValidSubmit="RegisterUser" FormName="register" class="mt-4">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" role="alert" />

                        <!-- Username -->
                        <div class="mb-3">
                            <label class="form-label" for="Input.Username">Username</label>
                            <div class="position-relative">
                                <input value="@Input.Username" @oninput="OnUsernameInput"
                                       id="Input.Username" class="@UsernameInputClass"
                                       autocomplete="username" aria-required="true" placeholder="Username" />
                                <span class="position-absolute top-50 end-0 translate-middle-y me-3">
                                    @switch (usernameStatus)
                                    {
                                        case AvailabilityStatus.Checking:
                                            <span class="spinner-border spinner-border-sm text-secondary"></span>
                                            break;
                                        case AvailabilityStatus.Available:
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                            break;
                                        case AvailabilityStatus.Taken:
                                            <i class="bi bi-x-circle-fill text-danger"></i>
                                            break;
                                    }
                                </span>
                            </div>
                            <small class="form-text">This is the name you will sign in with.</small>
                            @if (usernameStatus == AvailabilityStatus.Available)
                            {
                                <div class="text-success small mt-1"><i class="bi bi-check2 me-1"></i>@Input.Username is available</div>
                            }
                            else if (usernameStatus == AvailabilityStatus.Taken)
                            {
                                <div class="text-danger small mt-1"><i class="bi bi-exclamation-circle me-1"></i>@Input.Username is already taken</div>
                                @if (suggestions.Any())
                                {
                                    <div class="mt-2 small">
                                        <span class="text-body-secondary">Try one of these:</span>
                                        @foreach (string suggestion in suggestions)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 ms-1 mb-1"
                                                    @onclick="() => UseSuggestionAsync(suggestion)">
                                                @suggestion
                                            </button>
                                        }
                                    </div>
                                }
                            }
                            <ValidationMessage For="() => Input.Username" class="text-danger" />
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label" for="Input.Email">Email address</label>
                            <input value="@Input.Email" @oninput="OnEmailInput"
                                   id="Input.Email" class="form-control"
                                   autocomplete="email" aria-required="true" placeholder="you@example.com" />
                            @if (emailInUse)
                            {
                                <div class="text-danger small mt-1">
                                    <i class="bi bi-info-circle me-1"></i>
                                    An account with this email already exists.
                                    <a href="@LoginWithEmailUrl">Sign in instead</a>.
                                </div>
                            }
                            <ValidationMessage For="() => Input.Email" class="text-danger" />
                        </div>

                        <!-- Name / Surname -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="Input.Name">First name</label>
                                <InputText @bind-Value="Input.Name" id="Input.Name" class="form-control" autocomplete="given-name" aria-required="true" placeholder="First name" />
                                <ValidationMessage For="() => Input.Name" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="Input.Surname">Surname</label>
                                <InputText @bind-Value="Input.Surname" id="Input.Surname" class="form-control" autocomplete="family-name" aria-required="true" placeholder="Surname" />
                                <ValidationMessage For="() => Input.Surname" class="text-danger" />
                            </div>
                        </div>

                        <!-- Preferred name / Date of birth (optional) -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="Input.PreferredName">Preferred name <span class="text-body-secondary">(optional)</span></label>
                                <InputText @bind-Value="Input.PreferredName" id="Input.PreferredName" class="form-control" placeholder="Preferred name" />
                                <ValidationMessage For="() => Input.PreferredName" class="text-danger" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="Input.DateOfBirth">Date of birth <span class="text-body-secondary">(optional)</span></label>
                                <InputDate @bind-Value="Input.DateOfBirth" id="Input.DateOfBirth" class="form-control" />
                                <ValidationMessage For="() => Input.DateOfBirth" class="text-danger" />
                            </div>
                        </div>

                        <!-- Password -->
                        <div class="mb-3">
                            <label class="form-label" for="Input.Password">Password</label>
                            <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="*********" />
                            <ValidationMessage For="() => Input.Password" class="text-danger" />
                        </div>

                        <!-- Confirm password -->
                        <div class="mb-3">
                            <label class="form-label" for="Input.ConfirmPassword">Confirm Password</label>
                            <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="*********" />
                            <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                        </div>

                        <!-- Button -->
                        <div class="row align-items-center">
                            <div class="col-sm-4">
                                <button type="submit" class="btn btn-success" disabled="@isSubmitting">Sign me up</button>
                            </div>
                            <div class="col-sm-8 text-sm-end">
                                <span>
                                    Have an account? <a href="Account/Login"><u>Sign in</u></a>
                                </span>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum AvailabilityStatus { None, Checking, Available, Taken }

    private InputModel Input { get; set; } = new();
    private AvailabilityStatus usernameStatus = AvailabilityStatus.None;
    private List<string> suggestions = new();
    private bool emailInUse;
    private bool isSubmitting;
    private string? errorMessage;

    private CancellationTokenSource? usernameDebounce;
    private CancellationTokenSource? emailDebounce;

    private string UsernameInputClass => usernameStatus switch
    {
        AvailabilityStatus.Available => "form-control is-valid",
        AvailabilityStatus.Taken => "form-control is-invalid",
        _ => "form-control"
    };

    private string LoginWithEmailUrl =>
        NavigationManager.GetUriWithQueryParameters(
            "Account/Login", new Dictionary<string, object?> { ["username"] = Input.Email });

    private async Task OnUsernameInput(ChangeEventArgs args)
    {
        Input.Username = args.Value?.ToString() ?? string.Empty;
        await DebouncedUsernameCheckAsync();
    }

    private async Task OnEmailInput(ChangeEventArgs args)
    {
        Input.Email = args.Value?.ToString() ?? string.Empty;
        await DebouncedEmailCheckAsync();
    }

    private async Task DebouncedUsernameCheckAsync()
    {
        suggestions.Clear();
        usernameStatus = AvailabilityStatus.Checking;

        usernameDebounce?.Cancel();
        usernameDebounce = new CancellationTokenSource();
        CancellationToken token = usernameDebounce.Token;

        try
        {
            await Task.Delay(450, token);

            string candidate = Input.Username?.Trim() ?? string.Empty;

            if (candidate.Length < RegistrationViewService.MinimumUsernameLength)
            {
                usernameStatus = AvailabilityStatus.None;
                return;
            }

            bool available = await RegistrationViewService.IsUsernameAvailableAsync(candidate);

            if (token.IsCancellationRequested)
            {
                return;
            }

            if (available)
            {
                usernameStatus = AvailabilityStatus.Available;
            }
            else
            {
                usernameStatus = AvailabilityStatus.Taken;
                suggestions = await RegistrationViewService.SuggestUsernamesAsync(
                    Input.Name ?? string.Empty,
                    Input.Surname ?? string.Empty,
                    Input.PreferredName);
            }

            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke.
        }
    }

    private async Task DebouncedEmailCheckAsync()
    {
        emailDebounce?.Cancel();
        emailDebounce = new CancellationTokenSource();
        CancellationToken token = emailDebounce.Token;

        try
        {
            await Task.Delay(450, token);

            string candidate = Input.Email?.Trim() ?? string.Empty;

            emailInUse = candidate.Contains('@')
                && await RegistrationViewService.IsEmailInUseAsync(candidate);

            if (!token.IsCancellationRequested)
            {
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task UseSuggestionAsync(string suggestion)
    {
        Input.Username = suggestion;
        usernameStatus = AvailabilityStatus.Available;
        suggestions.Clear();
        await Task.CompletedTask;
    }

    private async Task RegisterUser()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            // Re-check on the server so a name taken between typing and submit is still caught.
            if (!await RegistrationViewService.IsUsernameAvailableAsync(Input.Username))
            {
                usernameStatus = AvailabilityStatus.Taken;
                errorMessage = "That username is already taken. Please choose another.";
                return;
            }

            if (await RegistrationViewService.IsEmailInUseAsync(Input.Email))
            {
                emailInUse = true;
                errorMessage = "An account with this email already exists. Please sign in instead.";
                return;
            }

            var user = new AppUser
            {
                Name = Input.Name,
                Surname = Input.Surname,
                PreferredName = string.IsNullOrWhiteSpace(Input.PreferredName) ? null : Input.PreferredName,
                DateOfBirth = Input.DateOfBirth,
                EmailConfirmed = true,
            };

            await UserStore.SetUserNameAsync(user, Input.Username, CancellationToken.None);
            var emailStore = (IUserEmailStore<AppUser>)UserStore;
            await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);

            IdentityResult result = await UserManager.CreateAsync(user, Input.Password);

            if (!result.Succeeded)
            {
                errorMessage = string.Join(" ", result.Errors.Select(error => error.Description));
                return;
            }

            await UserManager.AddToRoleAsync(user, "Users");
            Logger.LogInformation("New account created for {UserName}.", Input.Username);

            NavigationManager.NavigateTo(
                NavigationManager.GetUriWithQueryParameters(
                    "Account/Login",
                    new Dictionary<string, object?>
                    {
                        ["registered"] = true,
                        ["username"] = Input.Username,
                    }));
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(256, MinimumLength = 3)]
        [Display(Name = "Username")]
        public string Username { get; set; } = "";

        [Required]
        [EmailAddress]
        [Display(Name = "Email address")]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 1)]
        [Display(Name = "First name")]
        public string Name { get; set; } = "";

        [Required]
        [StringLength(100, MinimumLength = 1)]
        [Display(Name = "Surname")]
        public string Surname { get; set; } = "";

        [StringLength(100)]
        [Display(Name = "Preferred name")]
        public string? PreferredName { get; set; }

        [DataType(DataType.Date)]
        [Display(Name = "Date of birth")]
        public DateOnly? DateOfBirth { get; set; }

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 4)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
