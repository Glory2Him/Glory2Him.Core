# Shell scripts must keep LF endings. Checked out with CRLF on Windows, the
# shebang becomes "#!/bin/bash\r" and the interpreter is not found — the script
# fails everywhere it is run through a real shell, including Git Bash and CI.
*.sh text eol=lf

# Git hooks have no extension, so name the directory: a CRLF hook fails the same way.
.githooks/* text eol=lf

# The awk programs the hooks run stay LF, like the scripts that run them.
*.awk text eol=lf
